# Copier en docker/.env, puis renseigner. docker/.env n'est pas versionné.
#
# Toutes les valeurs sont vides à dessein : un gabarit qui contient « changez-moi »
# finit en production avec « changez-moi » comme mot de passe. Il faut que le serveur
# refuse de démarrer tant qu'on n'a pas décidé.

DOMAIN=api.exemple.ci
POSTGRES_DB=boutique
POSTGRES_USER=boutique

# openssl rand -base64 32
POSTGRES_PASSWORD=

# Premier compte de pilotage, créé au tout premier démarrage si la base n'en a aucun.
# Sans ces valeurs, un serveur neuf n'a aucun compte et personne ne peut s'y connecter.
# Dix caractères minimum. À changer depuis l'application dès la première connexion.
BOOTSTRAP_USERNAME=proprietaire
BOOTSTRAP_PASSWORD=
BOOTSTRAP_DISPLAY_NAME=Propriétaire

# Notifications web. Générer les clés une fois :
#   docker compose -f docker/compose.prod.yml run --rm server dotnet BoutiqueFashion.Server.dll vapid
VAPID_SUBJECT=mailto:contact@exemple.ci
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Passerelle WhatsApp OpenWA, hébergée sur le même serveur. Vide, les alertes WhatsApp ne partent pas.
OPENWA_BASE_URL=http://openwa:8002
OPENWA_API_KEY=
