# Copier en docker/.env et renseigner. Ce fichier-ci ne contient aucun secret réel.
DOMAIN=api.exemple.ci
POSTGRES_DB=boutique
POSTGRES_USER=boutique
POSTGRES_PASSWORD=changez-moi

# Premier compte de pilotage, créé au tout premier démarrage si la base n'en a aucun.
# Sans ces valeurs, un serveur neuf n'a aucun compte et personne ne peut s'y connecter.
# À changer depuis l'application dès la première connexion.
BOOTSTRAP_USERNAME=proprietaire
BOOTSTRAP_PASSWORD=au-moins-dix-caracteres
BOOTSTRAP_DISPLAY_NAME=Propriétaire
