# nginx occupe déjà 80 et 443 sur le serveur : Caddy écoute donc en clair sur la boucle locale
# et ne gère plus le TLS. Tout le routage de l'application reste ici, où il est déjà écrit et
# vérifié — le réécrire dans nginx aurait été une seconde chance de se tromper.
:80 {
	encode gzip zstd

	# L'API d'abord. Tout le reste est servi en fichiers statiques depuis la même origine :
	# aucune requête croisée, donc aucun CORS et aucune adresse à saisir côté client.
	handle /api/* {
		reverse_proxy server:8080
	}
	handle /health {
		reverse_proxy server:8080
	}

	# Flux et paquets de mise à jour des terminaux. Sans ce bloc, /updates tombe dans le repli
	# SPA de la vitrine plus bas : le terminal reçoit la page d'accueil du site en 200 au lieu
	# de son flux, Velopack n'y comprend rien, et le seul symptôme est une caisse qui ne se met
	# plus à jour — à trois heures de route, sans erreur nulle part.
	handle /updates/* {
		reverse_proxy server:8080
	}

	# L'application de pilotage, sous son propre chemin. Elle est privée : c'est la vitrine qui
	# occupe la racine, parce que c'est elle que les clientes atteignent.
	#
	# handle_path ne capte que /pilote/*, jamais /pilote tout court : sans cette redirection,
	# l'adresse que la propriétaire tape de mémoire tomberait sur la vitrine.
	redir /pilote /pilote/ 308

	handle_path /pilote/* {
		root * /srv/pilote
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	handle {
		root * /srv/vitrine
		@assets path /_next/static/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/ /index.html
		file_server
	}
}
