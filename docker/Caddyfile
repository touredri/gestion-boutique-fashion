{$DOMAIN} {
	encode gzip zstd

	# L'API d'abord : tout le reste est l'application, servie en fichiers statiques depuis la
	# même origine. Aucune requête croisée, donc aucun CORS à configurer et aucune adresse de
	# serveur à saisir dans l'application.
	handle /api/* {
		reverse_proxy server:8080
	}
	handle /health {
		reverse_proxy server:8080
	}

	handle {
		root * /srv/pilote
		# Le service worker ne doit jamais être servi depuis un cache : une version figée
		# empêcherait toute mise à jour de l'application d'atteindre le téléphone.
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		@assets path /_next/static/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/ /index.html
		file_server
	}
}
