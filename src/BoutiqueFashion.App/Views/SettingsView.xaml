<UserControl x:Class="BoutiqueFashion.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="20" MaxWidth="980" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="IDENTITÉ DOCUMENTAIRE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Boutique et factures" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ces informations sont figées sur les factures et duplicatas." Style="{StaticResource HelperText}" Margin="0,0,0,10"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Nom de la boutique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopName}"/></StackPanel><StackPanel><TextBlock Text="Slogan" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Slogan}"/></StackPanel><StackPanel><TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Address}"/></StackPanel><StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Phone}"/></StackPanel><StackPanel><TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Email}"/></StackPanel><StackPanel><TextBlock Text="NIF / RCCM" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaxId}"/></StackPanel><StackPanel><TextBlock Text="Chemin du logo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LogoPath}"/></StackPanel><StackPanel><TextBlock Text="Chemin du cachet" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StampPath}"/></StackPanel><StackPanel><TextBlock Text="Chemin de la signature" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SignaturePath}"/></StackPanel><StackPanel><TextBlock Text="Pied de page" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Footer}"/></StackPanel></UniformGrid><TextBlock Text="Politique de retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReturnPolicy}"/><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="PinBox_OnPasswordChanged" AutomationProperties.Name="PIN responsable"/><Button Content="Enregistrer tous les paramètres" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="4,10,4,4"/><TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="5" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="IMPRESSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Imprimante ticket" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ce choix reste mémorisé sur le terminal." Style="{StaticResource HelperText}" Margin="0,0,0,8"/><TextBlock Text="Imprimante thermique" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name"/><Button Content="Imprimer un ticket test" Command="{Binding TestPrinterCommand}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DONNÉES LOCALES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Sauvegarde" Style="{StaticResource SectionTitle}"/><TextBlock Text="Crée une copie vérifiée de la base locale." Style="{StaticResource HelperText}" Margin="0,0,0,8"/><Button Content="Sauvegarder maintenant" Command="{Binding BackupCommand}"/></StackPanel></Border></StackPanel></Grid></ScrollViewer></UserControl>
