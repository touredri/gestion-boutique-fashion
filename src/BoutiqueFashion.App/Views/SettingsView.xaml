<UserControl x:Class="BoutiqueFashion.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    
    <!-- En-tête -->
    <Grid Margin="4,0,4,12">
      <StackPanel>
        <TextBlock Text="Paramètres système" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="Configuration de la boutique, des documents et de l'impression" Style="{StaticResource SectionTitle}"/>
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Enregistrer tous les paramètres" Command="{Binding SaveCommand}" Style="{StaticResource HeroButton}" MinWidth="220"/>
    </Grid>

    <TabControl Grid.Row="1" Padding="0">
      <!-- Onglet 1 : Identité Boutique -->
      <TabItem Header="Identité boutique">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="18">
            <StackPanel>
              <TextBlock Text="IDENTITÉ COMMERCIALE &amp; COORDONNÉES" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
              <TextBlock Text="Ces mentions apparaîtront en en-tête de tous vos tickets de caisse, factures et avoirs." Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
              
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Nom commercial de la boutique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopName}" controls:Placeholder.Text="Nom de l'établissement"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Slogan / Devise" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Slogan}" controls:Placeholder.Text="Ex: La mode chic &amp; moderne"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Téléphone boutique" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Phone}" Title="Téléphone"/></StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Adresse géographique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Address}" controls:Placeholder.Text="Ville, Quartier, Rue..."/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Adresse E-mail" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Email}" controls:Placeholder.Text="contact@boutique.com"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="NIF / RCCM / N° Registre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaxId}" controls:Placeholder.Text="N° d'identification"/></StackPanel>
              </Grid>

              <Separator Margin="0,6,0,12"/>

              <TextBlock Text="ÉLÉMENTS VISUELS &amp; GRAPHISMES" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Logo de la boutique" Style="{StaticResource FieldLabel}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LogoPath}" IsReadOnly="True" controls:Placeholder.Text="Aucun fichier"/>
                    <Button Grid.Column="1" Content="Parcourir…" Click="BrowseLogo_OnClick" Margin="4,0,0,0"/>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                  <TextBlock Text="Cachet officiel" Style="{StaticResource FieldLabel}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding StampPath}" IsReadOnly="True" controls:Placeholder.Text="Aucun fichier"/>
                    <Button Grid.Column="1" Content="Parcourir…" Click="BrowseStamp_OnClick" Margin="4,0,0,0"/>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Signature numérisée" Style="{StaticResource FieldLabel}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SignaturePath}" IsReadOnly="True" controls:Placeholder.Text="Aucun fichier"/>
                    <Button Grid.Column="1" Content="Parcourir…" Click="BrowseSignature_OnClick" Margin="4,0,0,0"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <Separator Margin="0,6,0,12"/>

              <TextBlock Text="Pied de page des tickets thermiques" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Footer}" controls:Placeholder.Text="Ex: Merci pour votre visite ! Les articles soldés ne sont ni repris ni échangés." Margin="0,0,0,8"/>
              <TextBlock Text="Politique générale de retour" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ReturnPolicy}" controls:Placeholder.Text="Ex: Échange possible sous 7 jours sur présentation du ticket original."/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- Onglet 2 : Modèles de documents -->
      <TabItem Header="Documents &amp; modèles">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
          
          <!-- Paramètres des modèles -->
          <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Modèles par type de document" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                <TextBlock Text="Personnalisez le style graphique et les éléments affichés pour chaque document." Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,6,0"><TextBlock Text="Type de document" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Style de présentation" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"/></StackPanel>
                </Grid>

                <WrapPanel Margin="0,6,0,8">
                  <CheckBox Content="Afficher le Logo" IsChecked="{Binding FlagLogo}" Margin="0,4,16,4"/>
                  <CheckBox Content="Afficher le Slogan" IsChecked="{Binding FlagSlogan}" Margin="0,4,16,4"/>
                  <CheckBox Content="Afficher le Cachet" IsChecked="{Binding FlagStamp}" Margin="0,4,16,4"/>
                  <CheckBox Content="Afficher la Signature" IsChecked="{Binding FlagSignature}" Margin="0,4,16,4"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Content="Aperçu PDF complet" Command="{Binding PreviewTemplateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                  <Button Content="Aperçu ticket thermique" Command="{Binding PreviewTicketCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Numérotation -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="PRÉFIXES DE NUMÉROTATION DES SÉQUENCES" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                <TextBlock Text="Format des numéros attribués automatiquement aux pièces chaque année." Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
                <UniformGrid Columns="4">
                  <StackPanel Margin="2"><TextBlock Text="Ticket" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReceipt}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Facture" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqInvoice}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Proforma" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqProforma}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Acompte" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqDeposit}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Versement" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditPayment}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Solde" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqBalance}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Avoir" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditNote}"/></StackPanel>
                  <StackPanel Margin="2"><TextBlock Text="Bon retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReturnNote}"/></StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Rendu visuel du document -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="APERÇU DU MODÈLE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="6">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" VerticalAlignment="Top"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Onglet 3 : Règles métier -->
      <TabItem Header="Règles métier &amp; seuils">
        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="18">
          <StackPanel>
            <TextBlock Text="TOLÉRANCES ET SEGMENTATION DE LA CLIENTÈLE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
            <TextBlock Text="Définissez les seuils de segmentation automatique et la tolérance d'écart de caisse." Style="{StaticResource HelperText}" Margin="0,0,0,14"/>
            <UniformGrid Columns="3" Margin="0,0,0,8">
              <StackPanel Margin="0,0,8,8"><TextBlock Text="Tolérance écart de caisse" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding VarianceTolerance}" Title="Tolérance" Suffix="FCFA"/></StackPanel>
              <StackPanel Margin="0,0,8,8"><TextBlock Text="Seuil CA Client VIP (FCFA/an)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding VipRevenue}" Title="Seuil VIP" Suffix="FCFA"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><TextBlock Text="Nombre d'achats Client Fidèle" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding LoyalPurchases}" Title="Achats"/></StackPanel>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="Client inactif après (jours)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding InactiveDays}" Title="Jours"/></StackPanel>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="Considéré comme nouveau pendant (jours)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding NewDays}" Title="Jours"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- Onglet 4 : Impression -->
      <TabItem Header="Impression thermique">
        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="18">
          <StackPanel>
            <TextBlock Text="CONFIGURATION DE L'IMPRIMANTE THERMIQUE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
            <TextBlock Text="Sélectionnez l'imprimante thermique par défaut du point de vente." Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
            
            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" Margin="0,0,0,8">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Content="Découpe automatique du papier à la fin du ticket" IsChecked="{Binding CutPaper}" Margin="0,4,0,10"/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0"><TextBlock Text="Largeur du papier" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaperWidthOptions}" SelectedItem="{Binding SelectedPaperWidthOption}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Mode de rendu" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding RenderModes}" SelectedItem="{Binding SelectedRenderMode}"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="Vitesse série COM" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SerialBauds}" SelectedItem="{Binding SerialBaud}"/></StackPanel>
              <Button Grid.Column="3" Content="Diagnostiquer l'imprimante" Command="{Binding DiagnosePrinterCommand}" VerticalAlignment="Bottom" Margin="6,0,0,0" MinWidth="180"/>
            </Grid>

            <Separator Margin="0,6,0,12"/>

            <TextBlock Text="AJOUTER UNE IMPRIMANTE RÉSEAU (IP)" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding NetworkPrinter}" controls:Placeholder.Text="Ex: 192.168.1.50 ou 192.168.1.50:9100"/>
              <Button Grid.Column="1" Content="Ajouter l'imprimante" Command="{Binding AddNetworkPrinterCommand}" Margin="6,0,0,0" MinWidth="150"/>
              <Button Grid.Column="2" Content="Imprimer un ticket test" Command="{Binding TestPrinterCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" MinWidth="160"/>
            </Grid>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- Onglet 5 : Sécurité & Données -->
      <TabItem Header="Sécurité &amp; base de données">
        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="18">
          <StackPanel>
            <TextBlock Text="CODE PIN DU RESPONSABLE DE BOUTIQUE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
            <TextBlock Text="Le code PIN protège les opérations sensibles (annulations, suppressions, remises > 10%, crédits)." Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
            
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <controls:KeypadField Value="{Binding Pin}" Mask="True" Title="PIN actuel" Margin="0,0,8,0"/>
              <controls:KeypadField Grid.Column="1" Value="{Binding NewPin}" Mask="True" Title="Nouveau PIN" Margin="0,0,8,0"/>
              <Button Grid.Column="2" Content="Modifier le code PIN" Command="{Binding ChangePinCommand}" VerticalAlignment="Center" MinWidth="160"/>
            </Grid>

            <Separator Margin="0,6,0,12"/>

            <TextBlock Text="SAUVEGARDE DE LA BASE DE DONNÉES LOCALE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
            <TextBlock Text="Effectuez régulièrement une copie de sécurité de la base de données de votre boutique." Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
            <Button Content="Créer une sauvegarde maintenant" Command="{Binding BackupCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="240"/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="12,6" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</UserControl>
