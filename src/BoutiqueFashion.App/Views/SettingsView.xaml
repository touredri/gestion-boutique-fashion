<UserControl x:Class="BoutiqueFashion.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20" MaxWidth="1080" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="IDENTITÉ DOCUMENTAIRE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Boutique et factures" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Ces informations sont figées sur les documents au moment de l'émission." Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
            <UniformGrid Columns="2">
              <StackPanel><TextBlock Text="Nom de la boutique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopName}"/></StackPanel>
              <StackPanel><TextBlock Text="Slogan" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Slogan}"/></StackPanel>
              <StackPanel><TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Address}"/></StackPanel>
              <StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Phone}"/></StackPanel>
              <StackPanel><TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Email}"/></StackPanel>
              <StackPanel><TextBlock Text="NIF / RCCM" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaxId}"/></StackPanel>
              <StackPanel><TextBlock Text="Chemin du logo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LogoPath}"/></StackPanel>
              <StackPanel><TextBlock Text="Chemin du cachet" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StampPath}"/></StackPanel>
              <StackPanel><TextBlock Text="Chemin de la signature" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SignaturePath}"/></StackPanel>
              <StackPanel><TextBlock Text="Pied de page" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Footer}"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="Politique de retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReturnPolicy}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="NUMÉROTATION PAR TYPE DE DOCUMENT" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Préfixes de séquence annuels" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="4">
              <StackPanel><TextBlock Text="Ticket" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReceipt}"/></StackPanel>
              <StackPanel><TextBlock Text="Facture" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqInvoice}"/></StackPanel>
              <StackPanel><TextBlock Text="Proforma" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqProforma}"/></StackPanel>
              <StackPanel><TextBlock Text="Acompte" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqDeposit}"/></StackPanel>
              <StackPanel><TextBlock Text="Versement crédit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditPayment}"/></StackPanel>
              <StackPanel><TextBlock Text="Reçu de solde" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqBalance}"/></StackPanel>
              <StackPanel><TextBlock Text="Avoir" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditNote}"/></StackPanel>
              <StackPanel><TextBlock Text="Bon de retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReturnNote}"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="MODÈLES PAR TYPE DE DOCUMENT" Style="{StaticResource Eyebrow}" Margin="0,10,0,0"/>
            <WrapPanel>
              <StackPanel Width="220"><TextBlock Text="Type de document" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocType}"/></StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox Content="Logo" IsChecked="{Binding FlagLogo}" Margin="8,12,4,4"/>
                <CheckBox Content="Slogan" IsChecked="{Binding FlagSlogan}" Margin="8,12,4,4"/>
                <CheckBox Content="Cachet" IsChecked="{Binding FlagStamp}" Margin="8,12,4,4"/>
                <CheckBox Content="Signature" IsChecked="{Binding FlagSignature}" Margin="8,12,4,4"/>
              </StackPanel>
              <Button Content="Aperçu du modèle (PDF)" Command="{Binding PreviewTemplateCommand}" VerticalAlignment="Bottom"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="RÈGLES MÉTIER" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Tolérances et segmentation" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="5">
              <StackPanel><TextBlock Text="Tolérance écart caisse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VarianceTolerance}" ToolTip="FCFA"/></StackPanel>
              <StackPanel><TextBlock Text="Seuil VIP (FCFA/an)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VipRevenue}"/></StackPanel>
              <StackPanel><TextBlock Text="Achats client fidèle" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LoyalPurchases}"/></StackPanel>
              <StackPanel><TextBlock Text="Inactif après (jours)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding InactiveDays}"/></StackPanel>
              <StackPanel><TextBlock Text="Nouveau (jours)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewDays}"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="SÉCURITÉ" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="PIN responsable" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
              <StackPanel Width="180"><TextBlock Text="PIN actuel" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="PinBox_OnPasswordChanged" AutomationProperties.Name="PIN responsable"/></StackPanel>
              <StackPanel Width="180"><TextBlock Text="Nouveau PIN" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="NewPinBox_OnPasswordChanged" AutomationProperties.Name="Nouveau PIN"/></StackPanel>
              <Button Content="Changer le PIN" Command="{Binding ChangePinCommand}" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <Button Content="Enregistrer tous les paramètres" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="4,10,4,4"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="5" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="IMPRESSION" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Imprimante ticket" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Ce choix reste mémorisé sur le terminal." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
            <TextBlock Text="Imprimante thermique" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name"/>
            <Button Content="Imprimer un ticket test" Command="{Binding TestPrinterCommand}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="DONNÉES LOCALES" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Sauvegarde" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Crée une copie vérifiée de la base locale." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
            <Button Content="Sauvegarder maintenant" Command="{Binding BackupCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
