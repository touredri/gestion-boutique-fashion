<UserControl x:Class="BoutiqueFashion.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,0,10">
      <StackPanel>
        <TextBlock Text="PARAMÈTRES" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Configuration de la boutique, des documents et de l'impression" Style="{StaticResource SectionTitle}"/>
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Sauvegarder les changements" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
    </Grid>
    <TabControl Grid.Row="1" Padding="0">
      <TabItem Header="Boutique">
        <Border Style="{StaticResource Card}" Margin="6" Padding="14">
          <StackPanel>
            <TextBlock Text="IDENTITÉ DOCUMENTAIRE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Ces informations sont figées sur les documents au moment de l'émission." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
            <UniformGrid Columns="3">
              <StackPanel><TextBlock Text="Nom de la boutique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopName}" controls:Placeholder.Text="Nom de la boutique"/></StackPanel>
              <StackPanel><TextBlock Text="Slogan" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Slogan}" controls:Placeholder.Text="Slogan"/></StackPanel>
              <StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Phone}" Title="Téléphone"/></StackPanel>
              <StackPanel><TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Address}" controls:Placeholder.Text="Adresse"/></StackPanel>
              <StackPanel><TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Email}" controls:Placeholder.Text="E-mail"/></StackPanel>
              <StackPanel><TextBlock Text="NIF / RCCM" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaxId}" controls:Placeholder.Text="NIF / RCCM"/></StackPanel>
            </UniformGrid>
            <UniformGrid Columns="3">
              <StackPanel><TextBlock Text="Logo" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding LogoPath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowseLogo_OnClick" Margin="4,0,0,0"/></Grid></StackPanel>
              <StackPanel><TextBlock Text="Cachet" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding StampPath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowseStamp_OnClick" Margin="4,0,0,0"/></Grid></StackPanel>
              <StackPanel><TextBlock Text="Signature" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SignaturePath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowseSignature_OnClick" Margin="4,0,0,0"/></Grid></StackPanel>
            </UniformGrid>
            <TextBlock Text="Pied de page des tickets" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Footer}" controls:Placeholder.Text="Pied de page"/>
            <TextBlock Text="Politique de retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReturnPolicy}" controls:Placeholder.Text="Politique de retour"/>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Documents &amp; modèles">
        <Grid Margin="6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock Text="MODÈLES PAR TYPE DE DOCUMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Choisissez le type et le style : l'aperçu à droite se met à jour automatiquement." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Type de document" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Modèle prédéfini" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"/></StackPanel>
                </Grid>
                <WrapPanel Margin="4,8,0,2">
                  <CheckBox Content="Logo" IsChecked="{Binding FlagLogo}" Margin="0,4,16,4"/>
                  <CheckBox Content="Slogan" IsChecked="{Binding FlagSlogan}" Margin="0,4,16,4"/>
                  <CheckBox Content="Cachet" IsChecked="{Binding FlagStamp}" Margin="0,4,16,4"/>
                  <CheckBox Content="Signature" IsChecked="{Binding FlagSignature}" Margin="0,4,16,4"/>
                </WrapPanel>
                <WrapPanel Margin="4,6,0,0">
                  <Button Content="Aperçu du modèle (PDF)" Command="{Binding PreviewTemplateCommand}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Aperçu ticket (thermique)" Command="{Binding PreviewTicketCommand}" ToolTip="Affiche le rendu exact du ticket avant impression"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="NUMÉROTATION PAR TYPE DE DOCUMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Préfixes de séquence annuels" Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                <UniformGrid Columns="4">
                  <StackPanel><TextBlock Text="Ticket" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReceipt}"/></StackPanel>
                  <StackPanel><TextBlock Text="Facture" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqInvoice}"/></StackPanel>
                  <StackPanel><TextBlock Text="Proforma" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqProforma}"/></StackPanel>
                  <StackPanel><TextBlock Text="Acompte" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqDeposit}"/></StackPanel>
                  <StackPanel><TextBlock Text="Versement crédit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditPayment}"/></StackPanel>
                  <StackPanel><TextBlock Text="Reçu de solde" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqBalance}"/></StackPanel>
                  <StackPanel><TextBlock Text="Avoir" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqCreditNote}"/></StackPanel>
                  <StackPanel><TextBlock Text="Bon de retour" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SeqReturnNote}"/></StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="APERÇU DU MODÈLE" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Row="1" Text="Mis à jour au changement de type, de style ou d'éléments." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
              <Border Grid.Row="2" Background="White" BorderBrush="#E3D9CC" BorderThickness="1" CornerRadius="6" Padding="8">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" VerticalAlignment="Top"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Règles">
        <Border Style="{StaticResource Card}" Margin="6" Padding="14">
          <StackPanel>
            <TextBlock Text="RÈGLES MÉTIER" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Tolérances et segmentation clients" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="5">
              <StackPanel><TextBlock Text="Tolérance écart caisse" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding VarianceTolerance}" Title="Tolérance" Suffix="FCFA"/></StackPanel>
              <StackPanel><TextBlock Text="Seuil VIP (FCFA/an)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding VipRevenue}" Title="Seuil VIP" Suffix="FCFA"/></StackPanel>
              <StackPanel><TextBlock Text="Achats client fidèle" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding LoyalPurchases}" Title="Achats"/></StackPanel>
              <StackPanel><TextBlock Text="Inactif après (jours)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding InactiveDays}" Title="Jours"/></StackPanel>
              <StackPanel><TextBlock Text="Nouveau (jours)" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding NewDays}" Title="Jours"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Impression">
        <Border Style="{StaticResource Card}" Margin="6" Padding="14">
          <StackPanel>
            <TextBlock Text="IMPRIMANTE THERMIQUE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Sélectionnez l'imprimante à utiliser : l'imprimante intégrée du terminal apparaît en tête de liste (par défaut) si son pilote Windows est installé." Style="{StaticResource HelperText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <CheckBox Content="Découpe automatique du papier (désactiver si l'imprimante interne n'a pas de cutter)" IsChecked="{Binding CutPaper}" Margin="4,6,4,2"/>
            <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Width="120"><TextBlock Text="Largeur rouleau" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaperWidthOptions}" SelectedItem="{Binding SelectedPaperWidthOption}" ToolTip="Largeur du papier : 58 mm pour l'imprimante intégrée du terminal, 80 mm pour une caisse standard"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Mode d'impression" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding RenderModes}" SelectedItem="{Binding SelectedRenderMode}" ToolTip="ESC/POS brut : rapide. Rendu Windows : à essayer si rien ne sort avec l'imprimante intégrée."/></StackPanel>
              <StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Vitesse série (ports COM)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SerialBauds}" SelectedItem="{Binding SerialBaud}" ToolTip="Vitesse des imprimantes branchées en série"/></StackPanel>
              <Button Grid.Column="3" Content="Diagnostiquer l'imprimante" Command="{Binding DiagnosePrinterCommand}" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding NetworkPrinter}" controls:Placeholder.Text="192.168.1.50 ou 192.168.1.50:9100" ToolTip="Imprimante réseau : 192.168.1.50 ou 192.168.1.50:9100"/>
              <Button Grid.Column="1" Content="Ajouter" Command="{Binding AddNetworkPrinterCommand}" Margin="4,0,0,0"/>
              <Button Grid.Column="2" Content="Imprimer un ticket test" Command="{Binding TestPrinterCommand}" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"/>
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="4,8,4,0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Si rien ne sort : lancez « Diagnostiquer l'imprimante » (pilote, port, état), puis essayez le mode « Rendu Windows » et le ticket test. Vérifiez aussi papier et alimentation." Style="{StaticResource HelperText}" Margin="4,2,4,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Sécurité &amp; données">
        <Border Style="{StaticResource Card}" Margin="6" Padding="14">
          <StackPanel>
            <TextBlock Text="PIN RESPONSABLE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Le PIN protège les opérations sensibles. À la première utilisation, saisissez uniquement le nouveau PIN." Style="{StaticResource HelperText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <controls:KeypadField Value="{Binding Pin}" Mask="True" Title="PIN actuel" Margin="0,0,2,0"/>
              <controls:KeypadField Grid.Column="1" Value="{Binding NewPin}" Mask="True" Title="Nouveau PIN" Margin="2,4"/>
              <Button Grid.Column="2" Content="Changer le PIN" Command="{Binding ChangePinCommand}" VerticalAlignment="Center"/>
            </Grid>
            <Separator/>
            <TextBlock Text="DONNÉES LOCALES" Style="{StaticResource Eyebrow}" Margin="0,6,0,0"/>
            <WrapPanel>
              <Button Content="Sauvegarder la base maintenant" Command="{Binding BackupCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="12,4" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</UserControl>
