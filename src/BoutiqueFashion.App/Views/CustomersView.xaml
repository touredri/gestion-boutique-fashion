<UserControl x:Class="BoutiqueFashion.App.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><WrapPanel><TextBox Width="180" Text="{Binding Name}"/><TextBox Width="140" Text="{Binding Phone}"/><TextBox Width="130" Text="{Binding CreditLimit}"/><Button Content="Ajouter client" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCredit}"><DataGrid.Columns><DataGridTextColumn Header="Vente" Binding="{Binding SaleNumber}"/><DataGridTextColumn Header="Client" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Solde" Binding="{Binding BalanceXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="Échéance" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Versement crédit" FontSize="18" FontWeight="Bold"/><TextBox Text="{Binding PaymentAmount}" ToolTip="Montant"/><ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}"/><TextBox Text="{Binding PaymentReference}" ToolTip="Référence"/><Button Content="Enregistrer versement" Command="{Binding PayCreditCommand}" Style="{StaticResource PrimaryButton}"/><Separator/><TextBlock Text="Contre-écriture" FontWeight="Bold"/><TextBox Text="{Binding ReversalPaymentId}" ToolTip="ID du versement"/><PasswordBox PasswordChanged="CreditPin_OnPasswordChanged" Padding="8" Margin="4"/><Button Content="Contre-passer" Command="{Binding ReverseCreditCommand}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid></UserControl>
