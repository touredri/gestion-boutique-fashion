<UserControl x:Class="BoutiqueFashion.App.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}">
      <WrapPanel>
        <StackPanel Width="200"><TextBlock Text="Rechercher (nom ou téléphone)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <Button Content="Rechercher" Command="{Binding SearchCustomersCommand}" VerticalAlignment="Bottom"/>
        <StackPanel Width="160"><TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name}"/></StackPanel>
        <StackPanel Width="130"><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Phone}"/></StackPanel>
        <StackPanel Width="90"><TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Gender}"/></StackPanel>
        <StackPanel Width="160"><TextBlock Text="Préférences (tailles, couleurs)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Preferences}"/></StackPanel>
        <StackPanel Width="110"><TextBlock Text="Canal préféré" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Channel}"/></StackPanel>
        <StackPanel Width="110"><TextBlock Text="Plafond crédit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CreditLimit}"/></StackPanel>
        <CheckBox Content="Consentement promos" IsChecked="{Binding MarketingConsent}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Button Content="Ajouter client" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCustomer}"><DataGrid.Columns><DataGridTextColumn Header="CLIENT" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}"/><DataGridTextColumn Header="SEGMENT" Binding="{Binding Segment}"/><DataGridTextColumn Header="RESTE DÛ" Binding="{Binding OutstandingXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding HistorySales}"><DataGrid.Columns><DataGridTextColumn Header="ACHATS" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="DATE" Binding="{Binding Date,StringFormat=dd/MM/yy}"/><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="STATUT" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid>
          <DataGrid Grid.Column="1" ItemsSource="{Binding HistoryPayments}"><DataGrid.Columns><DataGridTextColumn Header="VERSEMENTS" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="VENTE" Binding="{Binding SaleNumber}"/><DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
        </Grid>
      </Grid>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="COMPLÉTER LA FICHE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Client sélectionné" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="2">
              <StackPanel><TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditName}"/></StackPanel>
              <StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditPhone}"/></StackPanel>
              <StackPanel><TextBlock Text="Tél. secondaire" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditSecondaryPhone}"/></StackPanel>
              <StackPanel><TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditGender}"/></StackPanel>
              <StackPanel><TextBlock Text="Préférences" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditPreferences}"/></StackPanel>
              <StackPanel><TextBlock Text="Canal préféré" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditChannel}"/></StackPanel>
              <StackPanel><TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditAddress}"/></StackPanel>
              <StackPanel><TextBlock Text="Plafond crédit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditCreditLimit}"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditNotes}"/>
            <CheckBox Content="Consentement communication commerciale" IsChecked="{Binding EditConsent}" Margin="4,6"/>
            <Button Content="Enregistrer la fiche" Command="{Binding SaveCustomerCommand}" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="CRÉDITS ET VERSEMENTS" Style="{StaticResource Eyebrow}"/>
            <DataGrid ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCredit}" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Vente" Binding="{Binding SaleNumber}"/><DataGridTextColumn Header="Client" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Solde" Binding="{Binding BalanceXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="Échéance" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}"/></DataGrid.Columns></DataGrid>
            <DataGrid ItemsSource="{Binding CreditPayments}" MaxHeight="180" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Versement" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Montant" Binding="{Binding AmountXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="Contre-passé" Binding="{Binding Reversed}"/><DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Contre-passer" Command="{Binding DataContext.ReverseCreditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" ToolTip="Créer une contre-écriture tracée"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            <TextBlock Text="Nouveau versement" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBox Text="{Binding PaymentAmount}" ToolTip="Montant"/>
            <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}"/>
            <TextBox Text="{Binding PaymentReference}" ToolTip="Référence"/>
            <Button Content="Enregistrer versement" Command="{Binding PayCreditCommand}" Style="{StaticResource PrimaryButton}"/>
            <TextBlock Text="PIN responsable (contre-écriture)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox PasswordChanged="CreditPin_OnPasswordChanged" Padding="8" Margin="4"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource HelperText}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
