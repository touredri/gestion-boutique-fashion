<UserControl x:Class="BoutiqueFashion.App.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" MinWidth="440"/><ColumnDefinition Width="0.9*" MinWidth="300" MaxWidth="520"/></Grid.ColumnDefinitions>
    
    <!-- Colonne Gauche : Liste et Historique -->
    <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      
      <!-- Recherche -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Rechercher par nom ou numéro de téléphone..." AutomationProperties.Name="Recherche client"/>
          <Button Grid.Column="1" Content="Rechercher" Command="{Binding SearchCustomersCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="110"/>
        </Grid>
      </Border>

      <!-- Actions sur sélection -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Modifier la fiche" Command="{Binding EditCustomerCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
            <Button Content="Archiver" Command="{Binding ArchiveCustomerCommand}" Margin="0,0,6,0"/>
            <Button Content="Supprimer" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource DangerButton}"/>
          </StackPanel>
          <controls:KeypadField Grid.Column="1" Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/>
        </Grid>
      </Border>

      <!-- Table des clients -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Répertoire clients" Style="{StaticResource Eyebrow}" Margin="2,0,0,6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCustomer}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="NOM DU CLIENT" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}" Width="130"/>
              <DataGridTextColumn Header="SEGMENT" Binding="{Binding Segment, Converter={StaticResource EnumFr}}" Width="110"/>
              <DataGridTextColumn Header="RESTE DÛ" Binding="{Binding OutstandingXof, StringFormat={}{0:N0} F}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Historique Achats & Versements -->
      <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- Achats -->
          <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Historique achats" Style="{StaticResource Eyebrow}" Margin="2,0,0,6"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding HistorySales}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="VENTE" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yy}" Width="80"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalXof, StringFormat={}{0:N0} F}" Width="95"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <!-- Versements -->
          <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Historique versements" Style="{StaticResource Eyebrow}" Margin="2,0,0,6"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryPayments}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="REÇU" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="RÉF VENTE" Binding="{Binding SaleNumber}" Width="100"/>
                <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof, StringFormat={}{0:N0} F}" Width="95"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Colonne Droite : Formulaires Fiche & Crédits -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <TabControl Padding="0" SelectedIndex="{Binding CustomerTab}">
          <!-- Onglet Fiche client -->
          <TabItem Header="Fiche client">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="2,4">
                <!-- Bloc Création rapide -->
                <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="NOUVEAU CLIENT" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name}" controls:Placeholder.Text="Nom complet du client" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <controls:KeypadField Value="{Binding Phone}" Title="Téléphone" Margin="0,0,4,0"/>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" ToolTip="Genre" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding Channel}" ToolTip="Canal préféré" Margin="0,0,4,0"/>
                      <controls:KeypadField Grid.Column="1" Value="{Binding CreditLimit}" Title="Plafond crédit" Suffix="F" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox Content="Consentement SMS / Promos" IsChecked="{Binding MarketingConsent}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="+ Ajouter le client" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Bloc Compléter / Modifier -->
                <Expander Header="Modifier les informations du client sélectionné" Padding="0" IsExpanded="{Binding EditExpanded}">
                  <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,6,0,0">
                    <StackPanel>
                      <UniformGrid Columns="2" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,4,4"><TextBlock Text="Nom complet" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditName}" controls:Placeholder.Text="Nom"/></StackPanel>
                        <StackPanel Margin="4,0,0,4"><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditPhone}" Title="Téléphone"/></StackPanel>
                        <StackPanel Margin="0,0,4,4"><TextBlock Text="Tél. secondaire" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditSecondaryPhone}" Title="Tél. 2"/></StackPanel>
                        <StackPanel Margin="4,0,0,4"><TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding EditGender}"/></StackPanel>
                        <StackPanel Margin="0,0,4,4"><TextBlock Text="Canal préféré" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding EditChannel}"/></StackPanel>
                        <StackPanel Margin="4,0,0,4"><TextBlock Text="Plafond crédit" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditCreditLimit}" Title="Plafond" Suffix="F"/></StackPanel>
                      </UniformGrid>
                      <TextBlock Text="Adresse géographique" Style="{StaticResource FieldLabel}"/>
                      <TextBox Text="{Binding EditAddress}" controls:Placeholder.Text="Adresse ou quartier..." Margin="0,0,0,4"/>
                      <TextBlock Text="Préférences (tailles, couleurs)" Style="{StaticResource FieldLabel}"/>
                      <TextBox Text="{Binding EditPreferences}" controls:Placeholder.Text="Ex: Taille M, Couleurs vives..." Margin="0,0,0,4"/>
                      <TextBlock Text="Notes internes" Style="{StaticResource FieldLabel}"/>
                      <TextBox Text="{Binding EditNotes}" controls:Placeholder.Text="Notes confidentielles..." Margin="0,0,0,6"/>
                      <CheckBox Content="Consentement communication commerciale" IsChecked="{Binding EditConsent}" Margin="0,0,0,8"/>
                      <Button Content="Enregistrer les modifications" Command="{Binding SaveCustomerCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                  </Border>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Onglet Crédits -->
          <TabItem Header="Gestion des crédits">
            <Grid Margin="2,4">
              <Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              
              <!-- Liste des crédits en cours -->
              <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="CRÉDITS EN COURS" Style="{StaticResource Eyebrow}" Margin="2,0,0,4"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCredit}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="VENTE" Binding="{Binding SaleNumber}" Width="80"/>
                    <DataGridTextColumn Header="CLIENT" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="SOLDE" Binding="{Binding BalanceXof, StringFormat={}{0:N0} F}" Width="90"/>
                    <DataGridTextColumn Header="ÉCHÉANCE" Binding="{Binding DueAt, StringFormat=dd/MM/yy}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>

              <!-- Versements associés -->
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="VERSEMENTS ENREGISTRÉS" Style="{StaticResource Eyebrow}" Margin="2,0,0,4"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding CreditPayments}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="N° REÇU" Binding="{Binding Number}" Width="80"/>
                    <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof, StringFormat={}{0:N0} F}" Width="90"/>
                    <DataGridTextColumn Header="ANNULÉ" Binding="{Binding Reversed, Converter={StaticResource BoolFr}}" Width="65"/>
                    <DataGridTemplateColumn Header="ACTION" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="Contre-passer" Command="{Binding DataContext.ReverseCreditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" FontSize="11" Padding="4,2"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>

              <!-- Formulaire de règlement -->
              <Border Grid.Row="2" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                  <TextBlock Text="ENREGISTRER UN NOUVEAU VERSEMENT" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:KeypadField Value="{Binding PaymentAmount}" Title="Montant versé" Suffix="FCFA" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}" Margin="4,0,0,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PaymentReference}" controls:Placeholder.Text="Référence du virement" Margin="0,0,4,0"/>
                    <controls:KeypadField Grid.Column="1" Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable" Margin="4,0,0,0"/>
                  </Grid>
                  <Button Content="Enregistrer le versement" Command="{Binding PayCreditCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="12,6"/>
    </Grid>
  </Grid>
</UserControl>
