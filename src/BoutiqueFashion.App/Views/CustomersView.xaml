<UserControl x:Class="BoutiqueFashion.App.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,8,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.25*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom ou téléphone" AutomationProperties.Name="Recherche client"/>
          <Button Grid.Column="1" Content="Rechercher" Command="{Binding SearchCustomersCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
        <WrapPanel>
          <Button Content="Modifier la fiche" Command="{Binding EditCustomerCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Archiver" Command="{Binding ArchiveCustomerCommand}"/>
          <Button Content="Supprimer" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource DangerButton}"/>
          <StackPanel Width="170"><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/></StackPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </WrapPanel>
      </Border>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCustomer}"><DataGrid.Columns><DataGridTextColumn Header="CLIENT" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}"/><DataGridTextColumn Header="SEGMENT" Binding="{Binding Segment, Converter={StaticResource EnumFr}}"/><DataGridTextColumn Header="RESTE DÛ" Binding="{Binding OutstandingXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding HistorySales}" Margin="0,0,4,0"><DataGrid.Columns><DataGridTextColumn Header="ACHATS" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="DATE" Binding="{Binding Date,StringFormat=dd/MM/yy}"/><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
        <DataGrid Grid.Column="1" ItemsSource="{Binding HistoryPayments}" Margin="4,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="VERSEMENTS" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="VENTE" Binding="{Binding SaleNumber}"/><DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Grid>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl Padding="0" SelectedIndex="{Binding CustomerTab}">
      <TabItem Header="Fiche client">
        <Grid Margin="8,6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12">
            <StackPanel>
              <TextBlock Text="NOUVEAU CLIENT" Style="{StaticResource Eyebrow}"/>
              <TextBox Text="{Binding Name}" controls:Placeholder.Text="Nom du client" ToolTip="Nom du client"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding Phone}" Title="Téléphone" Margin="4,4,2,4"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" ToolTip="Genre"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding Channel}" ToolTip="Canal préféré"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding CreditLimit}" Title="Plafond crédit" Suffix="FCFA" Margin="2,4,4,4"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Content="Consentement promos" IsChecked="{Binding MarketingConsent}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <Button Grid.Column="1" Content="Ajouter le client" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
              </Grid>
            </StackPanel>
          </Border>
          <Expander Grid.Row="1" Header="Compléter la fiche du client sélectionné" Padding="0" IsExpanded="{Binding EditExpanded}">
            <Border Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <UniformGrid Columns="2">
                  <StackPanel><TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditName}" controls:Placeholder.Text="Nom"/></StackPanel>
                  <StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditPhone}" Title="Téléphone"/></StackPanel>
                  <StackPanel><TextBlock Text="Tél. secondaire" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditSecondaryPhone}" Title="Téléphone secondaire"/></StackPanel>
                  <StackPanel><TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding EditGender}"/></StackPanel>
                  <StackPanel><TextBlock Text="Canal préféré" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding EditChannel}"/></StackPanel>
                  <StackPanel><TextBlock Text="Plafond crédit" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding EditCreditLimit}" Title="Plafond crédit" Suffix="FCFA"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditAddress}" controls:Placeholder.Text="Adresse"/>
                <TextBlock Text="Préférences (tailles, couleurs)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditPreferences}" controls:Placeholder.Text="Tailles, couleurs…"/>
                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditNotes}" controls:Placeholder.Text="Notes internes"/>
                <CheckBox Content="Consentement communication commerciale" IsChecked="{Binding EditConsent}" Margin="4,4"/>
                <Button Content="Enregistrer la fiche" Command="{Binding SaveCustomerCommand}" Style="{StaticResource PrimaryButton}"/>
              </StackPanel>
            </Border>
          </Expander>
        </Grid>
      </TabItem>
      <TabItem Header="Crédits">
        <Grid Margin="8,6">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCredit}"><DataGrid.Columns><DataGridTextColumn Header="VENTE" Binding="{Binding SaleNumber}"/><DataGridTextColumn Header="CLIENT" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="SOLDE" Binding="{Binding BalanceXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="ÉCHÉANCE" Binding="{Binding DueAt,StringFormat=dd/MM/yy}"/></DataGrid.Columns></DataGrid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding CreditPayments}" MaxHeight="170" Margin="0,6,0,0"><DataGrid.Columns><DataGridTextColumn Header="VERSET." Binding="{Binding Number}"/><DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof,StringFormat={}{0:N0}}"/><DataGridTextColumn Header="ANNULÉ" Binding="{Binding Reversed, Converter={StaticResource BoolFr}}"/><DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Contre-passer" Command="{Binding DataContext.ReverseCreditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" ToolTip="Créer une contre-écriture tracée"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
          <Border Grid.Row="2" Background="{StaticResource Ivory}" CornerRadius="10" Padding="10" Margin="0,6,0,0">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding PaymentAmount}" Title="Montant du versement" Suffix="FCFA" Margin="0,0,2,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}" Margin="2,4,0,4"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding PaymentReference}" ToolTip="Référence (optionnel)"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable" Margin="2,4,0,4"/>
              </Grid>
              <Button Content="Enregistrer le versement" Command="{Binding PayCreditCommand}" Style="{StaticResource PrimaryButton}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="12,4"/>
    </Grid>
  </Grid>
</UserControl>
