<UserControl x:Class="BoutiqueFashion.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="6,0,6,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AUJOURD'HUI" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="L'essentiel de la journée, en un coup d'œil" FontSize="20" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Vendre" Command="{Binding QuickSellCommand}" Style="{StaticResource HeroButton}" MinWidth="140"/>
        <Button Content="Produits" Command="{Binding QuickProductsCommand}" MinHeight="56" MinWidth="140" FontSize="16"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RaisedCard}" Background="{StaticResource Nav}" Padding="20">
        <StackPanel>
          <TextBlock Text="VENTES DU JOUR" Foreground="#FFBDB5AC" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary.SalesXof, StringFormat={}{0:N0} FCFA}" Foreground="White" FontSize="34" Style="{StaticResource Money}" Margin="0,6,0,2"/>
          <TextBlock Text="{Binding Summary.SalesCount, StringFormat={}{0} tickets enregistrés}" Foreground="#FFD4CDC5" FontSize="13"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ARGENT ENCAISSÉ" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Summary.CollectedXof, StringFormat={}{0:N0} FCFA}" FontSize="27" Style="{StaticResource Money}" Foreground="{StaticResource Success}" Margin="0,6,0,2"/>
          <TextBlock Text="Espèces, mobile money et carte" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Background="{StaticResource TerracottaSoft}" Padding="14">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Summary.LowStockCount}" FontSize="24" Foreground="{StaticResource TerracottaDark}" Style="{StaticResource Money}" VerticalAlignment="Center"/>
          <TextBlock Text=" articles à réapprovisionner&#10;(stock faible, rupture ou négatif)" Foreground="{StaticResource TerracottaDark}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource GoldSoft}" Padding="14">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Summary.CreditBalanceXof, StringFormat={}{0:N0}}" FontSize="24" Foreground="{StaticResource TerracottaDark}" Style="{StaticResource Money}" VerticalAlignment="Center"/>
          <TextBlock Text=" FCFA à encaisser&#10;chez les clients (crédits)" Foreground="{StaticResource TerracottaDark}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="DERNIÈRES VENTES" Style="{StaticResource Eyebrow}" Margin="6,0,0,4"/>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding RecentSales}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,9">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Customer}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding TotalXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Aucune vente pour l'instant aujourd'hui." Style="{StaticResource HelperText}" Margin="14,10" Visibility="{Binding Summary.SalesCount, Converter={StaticResource ZeroToVis}}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
