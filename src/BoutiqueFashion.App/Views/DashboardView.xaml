<UserControl x:Class="BoutiqueFashion.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><Grid Margin="6,0,6,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="APERÇU DU JOUR" Style="{StaticResource Eyebrow}"/><TextBlock Text="L’essentiel de votre activité" FontSize="20" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Background="{StaticResource GoldSoft}" CornerRadius="8" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="Mise à jour locale" Foreground="{StaticResource TerracottaDark}" FontWeight="SemiBold" FontSize="12"/></Border></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource RaisedCard}" Background="{StaticResource Nav}" Padding="22"><StackPanel><TextBlock Text="CHIFFRE D’AFFAIRES" Foreground="#FFBDB5AC" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.SalesXof, StringFormat={}{0:N0} FCFA}" Foreground="White" FontSize="30" Style="{StaticResource Money}" Margin="0,9,0,4"/><TextBlock Text="Ventes enregistrées aujourd’hui" Foreground="#FFD4CDC5" FontSize="12"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ENCAISSÉ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.CollectedXof, StringFormat={}{0:N0} FCFA}" FontSize="21" Style="{StaticResource Money}" Margin="0,10,0,4"/><TextBlock Text="Tous paiements" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MARGE BRUTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.GrossMarginXof, StringFormat={}{0:N0} FCFA}" FontSize="21" Style="{StaticResource Money}" Margin="0,10,0,4"/><TextBlock Text="Estimation du jour" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border></Grid><UniformGrid Columns="3" Margin="0,10,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DÉPENSES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.ExpensesXof, StringFormat={}{0:N0} FCFA}" FontSize="20" Style="{StaticResource Money}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CRÉANCES CLIENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.CreditBalanceXof, StringFormat={}{0:N0} FCFA}" FontSize="20" Style="{StaticResource Money}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="{StaticResource TerracottaSoft}"><StackPanel><TextBlock Text="ALERTES STOCK" Foreground="{StaticResource TerracottaDark}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.LowStockCount}" FontSize="24" Foreground="{StaticResource TerracottaDark}" Style="{StaticResource Money}" Margin="0,7,0,0"/><TextBlock Text="articles à surveiller" Foreground="{StaticResource TerracottaDark}" FontSize="12"/></StackPanel></Border></UniformGrid></StackPanel></ScrollViewer></UserControl>
