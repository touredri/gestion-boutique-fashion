<UserControl x:Class="BoutiqueFashion.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- En-tête avec titre et actions rapides -->
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Aujourd'hui" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
        <TextBlock Text="L'essentiel de la journée en un coup d'œil" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Nouvelle vente" Command="{Binding QuickSellCommand}" Style="{StaticResource HeroButton}" MinWidth="160" Margin="4,0"/>
        <Button Content="Gérer les produits" Command="{Binding QuickProductsCommand}" MinHeight="56" MinWidth="160" FontSize="15" Margin="4,0" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
        <!-- Bascule de mode : un seul code, saisi une fois, au lieu d'un PIN dans chaque écran. -->
        <Button Command="{Binding OpenManagerModeCommand}" MinHeight="56" MinWidth="170" FontSize="15" Margin="4,0" AutomationProperties.Name="Passer en mode gérant" Visibility="{Binding Session.IsSeller, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Mode gérant" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Content="Quitter le mode gérant" Command="{Binding LeaveManagerModeCommand}" Style="{StaticResource DangerButton}" MinHeight="56" MinWidth="190" FontSize="15" Margin="4,0" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </Grid>

    <!-- ÉTAT DE LA CAISSE.
         L'ouverture et la clôture ont migré vers l'écran Caisse : les tenir aux deux endroits
         aurait fait diverger deux copies de la même règle. Ici on informe, et on y renvoie. -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="4,0,4,12" Padding="16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCashOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="11" FontWeight="Bold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="● CAISSE FERMÉE"/>
                  <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCashOpen}" Value="True">
                      <Setter Property="Text" Value="● CAISSE OUVERTE"/>
                      <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <TextBlock Grid.Column="1" Text="{Binding CashSessionState}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="Aller encaisser une vente" Command="{Binding QuickSellCommand}" Style="{StaticResource PrimaryButton}" MinWidth="200"
                    Visibility="{Binding IsCashOpen, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Gérer la caisse" Command="{Binding QuickCashCommand}" MinWidth="160"/>
          </StackPanel>
        </Grid>

        <!-- Retour d'action : sans ce binding, la création du code gérant serait muette. -->
        <TextBlock Grid.Row="1" Text="{Binding CashStatus}" Style="{StaticResource StatusText}" Margin="2,10,2,0"/>
      </Grid>
    </Border>

    <!-- Cartes KPI principales -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RaisedCard}" Background="{StaticResource Terracotta}" Padding="22" Margin="4">
        <StackPanel>
          <TextBlock Text="Ventes du jour" Foreground="#FFFFF7" FontSize="12" FontWeight="Bold"/>
          <TextBlock Text="{Binding Summary.SalesXof, StringFormat={}{0:N0} FCFA}" Foreground="White" FontSize="36" Style="{StaticResource Money}" Margin="0,6,0,4"/>
          <Border Background="#33FFFFFF" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Summary.SalesCount, StringFormat={}{0} tickets enregistrés}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22" Margin="4">
        <StackPanel>
          <TextBlock Text="Argent encaissé" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Summary.CollectedXof, StringFormat={}{0:N0} FCFA}" FontSize="30" Style="{StaticResource Money}" Foreground="{StaticResource Success}" Margin="0,6,0,4"/>
          <TextBlock Text="Espèces, mobile money et carte" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Alertes et indicateurs secondaires.
         UniformGrid plutôt que Grid : il ignore les enfants repliés, donc la carte des crédits
         masquée au vendeur ne laisse pas une colonne vide au milieu du tableau de bord. -->
    <UniformGrid Grid.Row="3" Rows="1" Margin="0,8,0,0">
      <Border Style="{StaticResource Card}" Background="{StaticResource TerracottaSoft}" BorderBrush="{StaticResource Terracotta}" BorderThickness="1" Padding="16" Margin="4">
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource TerracottaDark}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
            <TextBlock Text="!" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Summary.LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TerracottaDark}" Style="{StaticResource Money}"/>
              <TextBlock Text=" articles en alerte stock" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TerracottaDark}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Articles à réapprovisionner (faible, rupture ou négatif)" Foreground="{StaticResource TerracottaDark}" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Article le mieux vendu. Agrégé par produit : « Robe Amina » et non « AMI-M-ROUGE ». -->
      <Border Style="{StaticResource Card}" Background="{StaticResource SuccessSoft}" BorderBrush="{StaticResource Success}" BorderThickness="1" Padding="16" Margin="4">
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource Success}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Summary.BestSeller.Label, TargetNullValue=Aucune vente ce jour, FallbackValue=Aucune vente ce jour}"
                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
              <Run Text="Article le mieux vendu ·"/>
              <Run Text="{Binding Summary.BestSeller.Quantity, StringFormat={}{0:0.##}, TargetNullValue=0, FallbackValue=0, Mode=OneWay}"/>
              <Run Text="pièce(s)"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Encours clients : information de gestion, hors du périmètre du vendeur. -->
      <Border Style="{StaticResource Card}" Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="16" Margin="4"
              Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource Gold}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
            <TextBlock Text="FCFA" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Summary.CreditBalanceXof, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" Style="{StaticResource Money}"/>
              <TextBlock Text=" FCFA à encaisser" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Solde des crédits clients en attente" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Dernières ventes avec en-tête structuré -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Dernières ventes" Style="{StaticResource Eyebrow}" Margin="6,0,0,6"/>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- En-tête du tableau -->
          <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <TextBlock Text="HEURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="NUMÉRO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="CLIENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <!-- Liste des ventes -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding RecentSales}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Customer}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Visibility="{Binding Summary.SalesCount, Converter={StaticResource ZeroToVis}}" Padding="24" HorizontalAlignment="Center">
                <TextBlock Text="Aucune vente enregistrée aujourd'hui." Style="{StaticResource HelperText}" FontSize="13" HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Dialogue du code gérant. Overlay dans la page et non fenêtre modale : le pavé tactile
         est ancré dans MainWindow et passerait derrière une modale. -->
    <Border Grid.RowSpan="5" Margin="-18" Background="{StaticResource Scrim}" Visibility="{Binding IsPinDialogOpen, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource RaisedCard}" Width="430" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="MODE GÉRANT" Style="{StaticResource Eyebrow}" Margin="2,0,2,4"/>

          <!-- Premier lancement : aucun code n'existe en base, on le fait créer. -->
          <StackPanel Visibility="{Binding IsPinCreation, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Créez votre code gérant" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Aucun code n'est encore défini. Choisissez 4 à 12 chiffres. Il protège les remises, les ventes à crédit, le stock et les paramètres — notez-le, il n'est récupérable que par restauration d'une sauvegarde." Style="{StaticResource HelperText}" Margin="2,0,2,10"/>
            <TextBlock Text="Nouveau code" Style="{StaticResource FieldLabel}"/>
            <controls:KeypadField Value="{Binding PinEntry}" Mask="True" Placeholder="4 à 12 chiffres" AutomationProperties.Name="Nouveau code gérant"/>
            <TextBlock Text="Confirmer le code" Style="{StaticResource FieldLabel}"/>
            <controls:KeypadField Value="{Binding PinConfirm}" Mask="True" Placeholder="Ressaisir le code" AutomationProperties.Name="Confirmation du code gérant"/>
          </StackPanel>

          <!-- Pas de Visibility en attribut : une valeur locale l'emporterait sur le déclencheur du style. -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPinCreation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Saisissez le code gérant" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Débloque les produits, le stock, les dépenses, les documents et les paramètres, ainsi que les remises et ventes à crédit." Style="{StaticResource HelperText}" Margin="2,0,2,10"/>
            <TextBlock Text="Code gérant" Style="{StaticResource FieldLabel}"/>
            <controls:KeypadField Value="{Binding PinEntry}" Mask="True" Placeholder="Toucher pour saisir" AutomationProperties.Name="Code gérant"/>
          </StackPanel>

          <TextBlock Text="{Binding PinDialogError}" Foreground="{StaticResource Danger}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,8,2,0"/>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Annuler" Command="{Binding CancelPinDialogCommand}"/>
            <Button Grid.Column="1" Content="Valider" Command="{Binding SubmitPinCommand}" Style="{StaticResource PrimaryButton}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
