<UserControl x:Class="BoutiqueFashion.App.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26">
    <StackPanel>
      <TextBlock Text="NOUVELLE DÉPENSE" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Loyer, salaires, transport, électricité…" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Toutes les dépenses enregistrées sont intégrées au bénéfice estimé." Foreground="{StaticResource Muted}" Margin="4,0,4,10"/>
      <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Category}"/>
      <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Description}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Montant FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Amount}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Payée par" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedMode}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      </Grid>
      <Button Content="Enregistrer la dépense" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
      <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="6"/>
    </StackPanel>
  </Border>
</UserControl>
