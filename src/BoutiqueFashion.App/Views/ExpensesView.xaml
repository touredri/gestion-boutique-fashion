<UserControl x:Class="BoutiqueFashion.App.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26"><StackPanel><TextBlock Text="Nouvelle dépense" FontSize="20" FontWeight="Bold"/><TextBlock Text="Toutes les dépenses enregistrées sont intégrées au bénéfice estimé." Foreground="{StaticResource Muted}" Margin="4,6,4,14"/><TextBox Text="{Binding Category}" ToolTip="Catégorie"/><TextBox Text="{Binding Description}" ToolTip="Description"/><TextBox Text="{Binding Amount}" ToolTip="Montant FCFA"/><ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedMode}"/><Button Content="Enregistrer la dépense" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="{Binding Status}" Margin="6"/></StackPanel></Border></UserControl>
