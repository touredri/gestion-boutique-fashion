<UserControl x:Class="BoutiqueFashion.App.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="300" MaxWidth="460"/><ColumnDefinition Width="1.4*" MinWidth="420"/></Grid.ColumnDefinitions>
    
    <!-- Formulaire d'enregistrement de dépense -->
    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,10,0" Padding="18">
      <StackPanel>
        <TextBlock Text="Nouvelle dépense" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="Enregistrer une charge" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Loyer, factures électricité, salaires, emballages, transport... Les dépenses sont déduites du bénéfice calculé." Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
        
        <TextBlock Text="Catégorie de dépense" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" Margin="0,0,0,6"/>
        
        <TextBlock Text="Description / Motif" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
        <TextBox Text="{Binding Description}" controls:Placeholder.Text="Précision sur la dépense..." Margin="0,0,0,6"/>
        
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Montant" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
            <controls:KeypadField Value="{Binding Amount}" Title="Montant" ShowTitle="False" Suffix="FCFA" Margin="0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Payée par" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
            <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedMode}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        
        <Button Content="Enregistrer la dépense" Command="{Binding CreateCommand}" Style="{StaticResource HeroButton}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="4,0"/>
      </StackPanel>
    </Border>

    <!-- Table des dernières dépenses -->
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Historique récent des dépenses" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
        
        <!-- Actions sur sélection -->
        <Border Grid.Row="1" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <Button Content="Supprimer la dépense sélectionnée" Command="{Binding DeleteExpenseCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" MinWidth="180"/>
            <controls:KeypadField Grid.Column="1" Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/>
          </Grid>
        </Border>

        <!-- Tableau des dépenses -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentExpenses}" SelectedItem="{Binding SelectedExpense}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat=dd/MM/yy HH:mm}" Width="130"/>
            <DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Category}" Width="130"/>
            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="MODE" Binding="{Binding Mode, Converter={StaticResource EnumFr}}" Width="110"/>
            <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof, StringFormat={}{0:N0} F}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
