<UserControl x:Class="BoutiqueFashion.App.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="460"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,8,0">
      <StackPanel>
        <TextBlock Text="NOUVELLE DÉPENSE" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Loyer, salaires, transport, électricité…" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Toutes les dépenses enregistrées sont intégrées au bénéfice estimé." Foreground="{StaticResource Muted}" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}"/>
        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Description}" controls:Placeholder.Text="Description de la dépense"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <controls:KeypadField Value="{Binding Amount}" Title="Montant" Suffix="FCFA" Margin="4,4,2,4"/>
          <StackPanel Grid.Column="1"><TextBlock Text="Payée par" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedMode}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        </Grid>
        <Button Content="Enregistrer la dépense" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="6"/>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="DERNIÈRES DÉPENSES" Style="{StaticResource Eyebrow}" Margin="4,0,0,6"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
          <Button Content="Supprimer la dépense" Command="{Binding DeleteExpenseCommand}" Style="{StaticResource DangerButton}"/>
          <StackPanel Width="170"><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/></StackPanel>
        </WrapPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentExpenses}" SelectedItem="{Binding SelectedExpense}"><DataGrid.Columns><DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt,StringFormat=dd/MM/yy}"/><DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Category}"/><DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="MODE" Binding="{Binding Mode, Converter={StaticResource EnumFr}}"/><DataGridTextColumn Header="MONTANT" Binding="{Binding AmountXof,StringFormat={}{0:N0}}"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
