<UserControl x:Class="BoutiqueFashion.App.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="440"/><ColumnDefinition Width="0.85*" MinWidth="300" MaxWidth="480"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Colonne Gauche : Tables organisées -->
    <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      
      <!-- Carte 1 : État des stocks -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="État général des stocks" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ARTICLE" Binding="{Binding Product.Name}" Width="*"/>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
              <DataGridTextColumn Header="STOCK" Binding="{Binding QuantityOnHand}" Width="90"/>
              <DataGridTextColumn Header="SEUIL" Binding="{Binding LowStockThreshold}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Text="Aucun produit en stock." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}"/>
        </Grid>
      </Border>

      <!-- Carte 2 : Onglets Alertes, Historique & Inventaire -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,4,0,0" Padding="14">
        <TabControl Padding="0">
          <!-- Alertes -->
          <TabItem Header="Alertes réappro">
            <Grid>
            <DataGrid ItemsSource="{Binding Alerts}" Margin="0,6,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                <DataGridTextColumn Header="ARTICLE" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="STOCK ACTUEL" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="NIVEAU D'ALERTE" Binding="{Binding Kind}" Width="120"/>
                <DataGridTextColumn Header="VENTE LIÉE" Binding="{Binding RelatedSale}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Aucune alerte : tous les stocks sont au-dessus de leur seuil." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Alerts.Count, Converter={StaticResource ZeroToVis}}"/>
            </Grid>
          </TabItem>

          <!-- Historique des mouvements -->
          <TabItem Header="Historique mouvements">
            <Grid>
            <DataGrid ItemsSource="{Binding History}" Margin="0,6,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM HH:mm}" Width="110"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding Type, Converter={StaticResource EnumFr}}" Width="110"/>
                <DataGridTextColumn Header="ÉCART" Binding="{Binding Delta}" Width="80"/>
                <DataGridTextColumn Header="MOTIF" Binding="{Binding Reason}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Aucun mouvement de stock." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding History.Count, Converter={StaticResource ZeroToVis}}"/>
            </Grid>
          </TabItem>

          <!-- Inventaire physique -->
          <TabItem Header="Inventaire physique">
            <Grid Margin="0,6,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Filtrer par catégorie" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Charger" Command="{Binding LoadFullInventoryCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" MinWidth="90"/>
                <Button Grid.Column="2" Content="Valider les écarts" Command="{Binding ApplyFullInventoryCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="8,0,0,0" MinWidth="130"/>
              </Grid>
              <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryLines}" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ARTICLE" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="STOCK THÉORIQUE" Binding="{Binding CurrentQuantity}" Width="130"/>
                  <DataGridTextColumn Header="QUANTITÉ COMPTÉE" Binding="{Binding CountedQuantity, UpdateSourceTrigger=LostFocus}" Width="140"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="1" Text="Chargez l'inventaire pour saisir les quantités comptées." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding InventoryLines.Count, Converter={StaticResource ZeroToVis}}"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <!-- Colonne Droite : Mouvements & Commandes -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <TabControl Padding="0">
          <TabItem Header="Mouvements">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,8">
              <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <TextBlock Text="Sélectionnez un article à gauche pour ajuster son stock." Style="{StaticResource HelperText}"/>
              </Border>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding Quantity}" Title="Quantité mouvement" Margin="0,0,4,0"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding CountedQuantity}" Title="Quantité comptée" Margin="4,0,0,0"/>
              </Grid>
              <TextBox Text="{Binding Reason}" controls:Placeholder.Text="Motif obligatoire" ToolTip="Motif obligatoire" Margin="0,0,0,6"/>
              <UniformGrid Columns="2" Margin="0,0,0,10">
                <Button Content="Réception" Command="{Binding ReceiveCommand}" Margin="2"/>
                <Button Content="Ajustement" Command="{Binding AdjustCommand}" Margin="2"/>
                <Button Content="Endommagé" Command="{Binding DamageCommand}" Style="{StaticResource DangerButton}" Margin="2"/>
                <Button Content="Perdu" Command="{Binding LoseCommand}" Style="{StaticResource DangerButton}" Margin="2"/>
              </UniformGrid>
              <Button Content="Valider l'inventaire compté" Command="{Binding ApplyInventoryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4"/>
            </StackPanel>
            </ScrollViewer>
          </TabItem>
          
          <TabItem Header="Commandes">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,8">
              <TextBox Text="{Binding Supplier}" controls:Placeholder.Text="Fournisseur" ToolTip="Fournisseur" Margin="0,0,0,6"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding OrderExpected}" Title="Quantité attendue"/>
                <Button Grid.Column="1" Content="+ Ligne" Command="{Binding AddToOrderCommand}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="70"/>
              </Grid>
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
              <ItemsControl ItemsSource="{Binding OrderLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding Expected, StringFormat=× {0:0.###}}" VerticalAlignment="Center" Style="{StaticResource Money}"/>
                      <Button Grid.Column="2" Content="×" FontSize="18" Margin="4,0,0,0" ToolTip="Retirer cette ligne" AutomationProperties.Name="Retirer cette ligne de commande" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveOrderLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
              <Button Content="Créer commande fournisseur" Command="{Binding CreateOrderCommand}" Margin="0,0,0,10"/>
              <TextBlock Text="Réceptions en attente" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
              <DataGrid ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding SelectedOpenLine}" MaxHeight="130" IsReadOnly="True" Margin="0,0,0,6">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="FOURNISSEUR" Binding="{Binding Supplier}" Width="*"/>
                  <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="80"/>
                  <DataGridTextColumn Header="ATTENDU" Binding="{Binding Expected}" Width="70"/>
                  <DataGridTextColumn Header="REÇU" Binding="{Binding Received}" Width="60"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Aucune réception en attente." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding OpenOrders.Count, Converter={StaticResource ZeroToVis}}"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding ReceivedQuantity}" Title="Qté reçue" Margin="0,0,4,0"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding ReceivedCost}" Title="Coût unitaire" Suffix="F" Margin="4,0,0,0"/>
              </Grid>
              <Button Content="Réceptionner la ligne" Command="{Binding ReceiveSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,2"/>
            </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
    <!-- Sur les deux colonnes : les actions de gauche écrivaient leur retour dans la colonne de droite. -->
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="4,8,4,0"/>
  </Grid>
</UserControl>
