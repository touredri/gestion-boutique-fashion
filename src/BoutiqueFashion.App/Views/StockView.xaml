<UserControl x:Class="BoutiqueFashion.App.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,8,0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0.62*"/><RowDefinition Height="0.62*"/><RowDefinition Height="0.78*"/></Grid.RowDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Stock" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="Seuil" Binding="{Binding LowStockThreshold}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Article" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Stock" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Alerte" Binding="{Binding Kind}"/><DataGridTextColumn Header="Vente liée" Binding="{Binding RelatedSale}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="2" ItemsSource="{Binding History}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=dd/MM HH:mm}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource EnumFr}}"/><DataGridTextColumn Header="Écart" Binding="{Binding Delta}"/><DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="INVENTAIRE COMPLET OU PAR CATÉGORIE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
          <StackPanel Width="190"><TextBlock Text="Catégorie (vide = tout)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"/></StackPanel>
          <Button Content="Charger" Command="{Binding LoadFullInventoryCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Valider les écarts comptés" Command="{Binding ApplyFullInventoryCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryLines}" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Stock théorique" Binding="{Binding CurrentQuantity}"/><DataGridTextColumn Header="Quantité comptée" Binding="{Binding CountedQuantity, UpdateSourceTrigger=LostFocus}"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Grid>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="0">
        <TabControl Padding="0">
          <TabItem Header="Mouvements">
            <StackPanel Margin="8,6">
              <TextBlock Text="Article sélectionné dans la liste de gauche" Style="{StaticResource HelperText}" Margin="4,0,4,6"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding Quantity}" Title="Quantité du mouvement" Margin="0,0,2,0"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding CountedQuantity}" Title="Quantité comptée" Margin="2,4,0,4"/>
              </Grid>
              <TextBox Text="{Binding Reason}" controls:Placeholder.Text="Motif obligatoire" ToolTip="Motif obligatoire"/>
              <controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/>
              <UniformGrid Columns="2" Margin="0,4,0,0">
                <Button Content="Réception" Command="{Binding ReceiveCommand}"/>
                <Button Content="Ajustement" Command="{Binding AdjustCommand}"/>
                <Button Content="Endommagé" Command="{Binding DamageCommand}" Style="{StaticResource DangerButton}"/>
                <Button Content="Perdu" Command="{Binding LoseCommand}" Style="{StaticResource DangerButton}"/>
              </UniformGrid>
              <Button Content="Valider l'inventaire compté" Command="{Binding ApplyInventoryCommand}" Style="{StaticResource PrimaryButton}" Margin="4,2"/>
            </StackPanel>
          </TabItem>
          <TabItem Header="Commandes">
            <StackPanel Margin="8,6">
              <TextBox Text="{Binding Supplier}" controls:Placeholder.Text="Fournisseur" ToolTip="Fournisseur"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding OrderExpected}" Title="Quantité attendue (variante sélectionnée)"/>
                <Button Grid.Column="1" Content="+ Ligne" Command="{Binding AddToOrderCommand}" VerticalAlignment="Center"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding OrderLines}" MaxHeight="86"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Expected, StringFormat=× {0:0.###}}" VerticalAlignment="Center" Style="{StaticResource Money}"/><Button Grid.Column="2" Content="×" MinWidth="0" Width="36" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemoveOrderLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Button Content="Créer la commande fournisseur" Command="{Binding CreateOrderCommand}" Margin="4,2"/>
              <TextBlock Text="Réceptions en attente" Style="{StaticResource FieldLabel}"/>
              <DataGrid ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding SelectedOpenLine}" MaxHeight="140" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fournisseur" Binding="{Binding Supplier}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Attendu" Binding="{Binding Expected}"/><DataGridTextColumn Header="Reçu" Binding="{Binding Received}"/></DataGrid.Columns></DataGrid>
              <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding ReceivedQuantity}" Title="Quantité reçue" Margin="0,0,2,0"/>
                <controls:KeypadField Grid.Column="1" Value="{Binding ReceivedCost}" Title="Coût unitaire" Suffix="FCFA" Margin="2,4,0,4"/>
              </Grid>
              <Button Content="Réceptionner la ligne sélectionnée" Command="{Binding ReceiveSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="4,2"/>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Border>
      <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource HelperText}" Margin="12,4"/>
    </Grid>
  </Grid>
</UserControl>
