<UserControl x:Class="BoutiqueFashion.App.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0.7*"/><RowDefinition Height="0.7*"/><RowDefinition Height="0.8*"/></Grid.RowDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Stock" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="Seuil" Binding="{Binding LowStockThreshold}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Article" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Stock" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Alerte" Binding="{Binding Kind}"/><DataGridTextColumn Header="Vente liée" Binding="{Binding RelatedSale}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="2" ItemsSource="{Binding History}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=dd/MM HH:mm}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Type" Binding="{Binding Type}"/><DataGridTextColumn Header="Écart" Binding="{Binding Delta}"/><DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="INVENTAIRE COMPLET OU PAR CATÉGORIE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
          <TextBox Width="180" Text="{Binding CategoryFilter}" ToolTip="Filtre catégorie (vide = tout)"/>
          <Button Content="Charger" Command="{Binding LoadFullInventoryCommand}"/>
          <Button Content="Valider les écarts comptés" Command="{Binding ApplyFullInventoryCommand}" Style="{StaticResource PrimaryButton}"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryLines}" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Stock théorique" Binding="{Binding CurrentQuantity}"/><DataGridTextColumn Header="Quantité comptée" Binding="{Binding CountedQuantity, UpdateSourceTrigger=LostFocus}"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Stock et inventaire" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="Quantité (mouvement)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Quantity}" ToolTip="Mouvement"/>
          <TextBlock Text="Quantité comptée (article sélectionné)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CountedQuantity}" ToolTip="Quantité réellement comptée"/>
          <TextBlock Text="Motif obligatoire" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Reason}" ToolTip="Motif"/>
          <TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="PinBox_OnPasswordChanged" Padding="10" Margin="4"/>
          <Button Content="Réception fournisseur" Command="{Binding ReceiveCommand}"/>
          <Button Content="Ajustement" Command="{Binding AdjustCommand}"/>
          <Button Content="Endommagé (sortie)" Command="{Binding DamageCommand}" Style="{StaticResource DangerButton}"/>
          <Button Content="Perdu (sortie)" Command="{Binding LoseCommand}" Style="{StaticResource DangerButton}"/>
          <Button Content="Valider inventaire compté" Command="{Binding ApplyInventoryCommand}" Style="{StaticResource PrimaryButton}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource HelperText}" Margin="4,6"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
