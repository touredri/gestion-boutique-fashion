<UserControl x:Class="BoutiqueFashion.App.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Stock" Binding="{Binding QuantityOnHand}"/></DataGrid.Columns></DataGrid><DataGrid Grid.Row="1" ItemsSource="{Binding History}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=dd/MM HH:mm}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Type" Binding="{Binding Type}"/><DataGridTextColumn Header="Écart" Binding="{Binding Delta}"/><DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></Grid><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stock et inventaire" FontSize="19" FontWeight="Bold"/><TextBox Text="{Binding Quantity}" ToolTip="Mouvement"/><TextBox Text="{Binding CountedQuantity}" ToolTip="Quantité réellement comptée"/><TextBox Text="{Binding Reason}" ToolTip="Motif"/><PasswordBox PasswordChanged="PinBox_OnPasswordChanged" Padding="10" Margin="4"/><Button Content="Réception" Command="{Binding ReceiveCommand}"/><Button Content="Ajustement" Command="{Binding AdjustCommand}"/><Button Content="Valider inventaire compté" Command="{Binding ApplyInventoryCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></Border></Grid></UserControl>
