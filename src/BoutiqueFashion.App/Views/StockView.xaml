<UserControl x:Class="BoutiqueFashion.App.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0.7*"/><RowDefinition Height="0.7*"/><RowDefinition Height="0.8*"/></Grid.RowDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Stock" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="Seuil" Binding="{Binding LowStockThreshold}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Article" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Stock" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Alerte" Binding="{Binding Kind}"/><DataGridTextColumn Header="Vente liée" Binding="{Binding RelatedSale}"/></DataGrid.Columns></DataGrid>
      <DataGrid Grid.Row="2" ItemsSource="{Binding History}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=dd/MM HH:mm}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource EnumFr}}"/><DataGridTextColumn Header="Écart" Binding="{Binding Delta}"/><DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="INVENTAIRE COMPLET OU PAR CATÉGORIE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
          <StackPanel Width="200"><TextBlock Text="Catégorie (vide = tout)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CategoryFilter}"/></StackPanel>
          <Button Content="Charger" Command="{Binding LoadFullInventoryCommand}"/>
          <Button Content="Valider les écarts comptés" Command="{Binding ApplyFullInventoryCommand}" Style="{StaticResource PrimaryButton}"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryLines}" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Stock théorique" Binding="{Binding CurrentQuantity}"/><DataGridTextColumn Header="Quantité comptée" Binding="{Binding CountedQuantity, UpdateSourceTrigger=LostFocus}"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Stock réel et mouvements" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="Article sélectionné dans la liste de gauche" Style="{StaticResource HelperText}" Margin="4,0,4,8"/>
          <TextBlock Text="Quantité du mouvement" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Quantity}"/>
          <TextBlock Text="Quantité comptée (inventaire unitaire)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CountedQuantity}"/>
          <TextBlock Text="Motif obligatoire" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Reason}"/>
          <TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="PinBox_OnPasswordChanged" Padding="10" Margin="4"/>
          <Button Content="Réception fournisseur" Command="{Binding ReceiveCommand}"/>
          <Button Content="Ajustement validé" Command="{Binding AdjustCommand}"/>
          <Button Content="Endommagé (sortie)" Command="{Binding DamageCommand}" Style="{StaticResource DangerButton}"/>
          <Button Content="Perdu (sortie)" Command="{Binding LoseCommand}" Style="{StaticResource DangerButton}"/>
          <Button Content="Valider inventaire compté" Command="{Binding ApplyInventoryCommand}" Style="{StaticResource PrimaryButton}"/>
          <Separator/>
          <TextBlock Text="FOURNISSEURS ET RÉCEPTIONS" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Commande : quantités attendues puis reçues" Style="{StaticResource HelperText}" Margin="4,0,4,8"/>
          <TextBlock Text="Fournisseur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Quantité attendue (variante sélectionnée)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OrderExpected}"/></StackPanel>
            <Button Grid.Column="1" Content="+ Ligne" Command="{Binding AddToOrderCommand}" VerticalAlignment="Bottom"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding OrderLines}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><TextBlock Text="{Binding Expected, StringFormat=× {0:0.###}}" VerticalAlignment="Center" Style="{StaticResource Money}"/><Button Grid.Column="1" Content="×" MinWidth="0" Width="40" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemoveOrderLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="Créer la commande fournisseur" Command="{Binding CreateOrderCommand}"/>
          <TextBlock Text="Réceptions en attente" Style="{StaticResource FieldLabel}"/>
          <DataGrid ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding SelectedOpenLine}" MaxHeight="180" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fournisseur" Binding="{Binding Supplier}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Attendu" Binding="{Binding Expected}"/><DataGridTextColumn Header="Reçu" Binding="{Binding Received}"/></DataGrid.Columns></DataGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Quantité reçue" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReceivedQuantity}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Coût unitaire (optionnel)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReceivedCost}" ToolTip="Vide = coût actuel"/></StackPanel>
          </Grid>
          <Button Content="Réceptionner la ligne sélectionnée" Command="{Binding ReceiveSelectedCommand}" Style="{StaticResource PrimaryButton}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource HelperText}" Margin="4,6"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
