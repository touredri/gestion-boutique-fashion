<UserControl x:Class="BoutiqueFashion.App.Views.DocumentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="4,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="HISTORIQUE DOCUMENTAIRE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Tickets, factures, avoirs, bons et proformas" Style="{StaticResource SectionTitle}"/></StackPanel>
        <StackPanel Grid.Column="1" Width="260"><TextBlock Text="Rechercher par numéro" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recherche par numéro de document"/></StackPanel>
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDocument}"><DataGrid.Columns><DataGridTextColumn Header="NUMÉRO" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Type}"/><DataGridTextColumn Header="DATE" Binding="{Binding IssuedAt,StringFormat=dd/MM/yyyy HH:mm}"/><DataGridTextColumn Header="IMPR." Binding="{Binding PrintCount}"/></DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Duplicata thermique" Command="{Binding DuplicateCommand}"/><Button Content="Exporter PDF" Command="{Binding ExportPdfCommand}"/><Button Content="Imprimer A4" Command="{Binding PrintA4Command}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
    </Grid>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="RETOUR ET CORRECTION" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Retour, échange ou annulation" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Numéro de vente" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SaleNumber}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SKU retourné" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReturnedSku}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Quantité" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReturnedQuantity}"/></StackPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SKU de remplacement" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReplacementSku}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Quantité" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReplacementQuantity}"/></StackPanel></Grid>
            <CheckBox Content="Réintégrer l'article en stock (décocher = mise au rebut)" IsChecked="{Binding Restock}" Margin="4,6"/>
            <TextBlock Text="Règlement de la différence" Style="{StaticResource FieldLabel}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding ExchangePaymentAmount}" ToolTip="Montant"/><ComboBox Grid.Column="1" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding ExchangePaymentMode}"/><TextBox Grid.Column="2" Text="{Binding ExchangePaymentReference}" ToolTip="Référence"/></Grid>
            <TextBlock Text="Motif obligatoire" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Reason}"/>
            <TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="DocumentPin_OnPasswordChanged"/>
            <Button Content="Valider retour ou échange" Command="{Binding ReturnExchangeCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Annuler toute la vente" Command="{Binding CancelSaleCommand}" Style="{StaticResource DangerButton}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="PROFORMA" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Nouvelle proforma" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProformaDescription}"/>
            <TextBlock Text="Total FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProformaTotal}"/>
            <Button Content="Créer la proforma" Command="{Binding ProformaCommand}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="8" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
