<UserControl x:Class="BoutiqueFashion.App.Views.DocumentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions><StackPanel><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDocument}" Height="430"><DataGrid.Columns><DataGridTextColumn Header="Numéro" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}"/><DataGridTextColumn Header="Date" Binding="{Binding IssuedAt,StringFormat=dd/MM/yyyy HH:mm}"/><DataGridTextColumn Header="Impressions" Binding="{Binding PrintCount}"/></DataGrid.Columns></DataGrid><Button Content="Réimprimer comme DUPLICATA" Command="{Binding DuplicateCommand}"/></StackPanel><ScrollViewer Grid.Column="1"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Retour / échange / annulation" FontSize="18" FontWeight="Bold"/><TextBox Text="{Binding SaleNumber}" ToolTip="N° vente"/><WrapPanel><TextBox Width="150" Text="{Binding ReturnedSku}" ToolTip="SKU retourné"/><TextBox Width="80" Text="{Binding ReturnedQuantity}"/></WrapPanel><WrapPanel><TextBox Width="150" Text="{Binding ReplacementSku}" ToolTip="SKU remplacement"/><TextBox Width="80" Text="{Binding ReplacementQuantity}"/></WrapPanel><WrapPanel><TextBox Width="100" Text="{Binding ExchangePaymentAmount}" ToolTip="Différence"/><ComboBox Width="120" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding ExchangePaymentMode}"/><TextBox Width="120" Text="{Binding ExchangePaymentReference}"/></WrapPanel><TextBox Text="{Binding Reason}" ToolTip="Motif"/><PasswordBox PasswordChanged="DocumentPin_OnPasswordChanged" Padding="8" Margin="4"/><Button Content="Valider retour/échange" Command="{Binding ReturnExchangeCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Annuler toute la vente" Command="{Binding CancelSaleCommand}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nouvelle proforma" FontSize="18" FontWeight="Bold"/><TextBox Text="{Binding ProformaDescription}"/><TextBox Text="{Binding ProformaTotal}"/><Button Content="Créer proforma" Command="{Binding ProformaCommand}"/></StackPanel></Border><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="8"/></StackPanel></ScrollViewer></Grid></UserControl>
