<UserControl x:Class="BoutiqueFashion.App.Views.DocumentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="440"/><ColumnDefinition Width="0.85*" MinWidth="300" MaxWidth="480"/></Grid.ColumnDefinitions>
    
    <!-- Colonne Gauche : Historique et Impression -->
    <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      
      <!-- En-tête et recherche -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Historique des documents" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
            <TextBlock Text="Tickets, factures, avoirs et proformas" Style="{StaticResource SectionTitle}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Rechercher par numéro" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="N° de ticket ou facture..." AutomationProperties.Name="Recherche par numéro de document"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Table des documents -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDocument}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="NUMÉRO" Binding="{Binding Number}" Width="*"/>
            <DataGridTextColumn Header="TYPE DE PIÈCE" Binding="{Binding Type, Converter={StaticResource EnumFr}}" Width="140"/>
            <DataGridTextColumn Header="DATE D'ÉMISSION" Binding="{Binding IssuedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
            <DataGridTextColumn Header="IMPRESSIONS" Binding="{Binding PrintCount}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Actions d'impression -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <!-- Sélecteurs d'imprimantes -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="Imprimante Ticket thermique" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
              <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" AutomationProperties.Name="Imprimante ticket">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Text="Imprimante Bureautique A4" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
              <ComboBox ItemsSource="{Binding A4Printers}" SelectedItem="{Binding SelectedA4Printer}" AutomationProperties.Name="Imprimante A4"/>
            </StackPanel>
          </Grid>
          <!-- Boutons d'impression -->
          <UniformGrid Grid.Row="1" Columns="4">
            <Button Content="Aperçu ticket" Command="{Binding PreviewDocumentCommand}" Margin="2" AutomationProperties.Name="Aperçu du ticket"/>
            <Button Content="Duplicata" Command="{Binding DuplicateCommand}" Margin="2" AutomationProperties.Name="Imprimer un duplicata thermique"/>
            <Button Content="Imprimer A4" Command="{Binding PrintA4Command}" Style="{StaticResource PrimaryButton}" Margin="2" AutomationProperties.Name="Imprimer en format A4"/>
            <Button Content="Exporter PDF" Command="{Binding ExportPdfCommand}" Margin="2" AutomationProperties.Name="Exporter en PDF"/>
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Colonne Droite : Opérations & Aperçu papier -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      
      <!-- Onglets Opérations -->
      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
        <TabControl Padding="0">
          <!-- Retour / Échange -->
          <TabItem Header="Retour / Échange">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="2,4">
                <TextBox Text="{Binding SaleNumber}" controls:Placeholder.Text="Numéro de la vente originale" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding ReturnedSku}" controls:Placeholder.Text="SKU article retourné" Margin="0,0,4,0"/>
                  <controls:KeypadField Grid.Column="1" Value="{Binding ReturnedQuantity}" Title="Qté retournée" Margin="4,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding ReplacementSku}" controls:Placeholder.Text="SKU remplacement (optionnel)" Margin="0,0,4,0"/>
                  <controls:KeypadField Grid.Column="1" Value="{Binding ReplacementQuantity}" Title="Qté remplacement" Margin="4,0,0,0"/>
                </Grid>
                <CheckBox Content="Réintégrer les articles en stock" IsChecked="{Binding Restock}" Margin="0,2,0,6"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <controls:KeypadField Value="{Binding ExchangePaymentAmount}" Title="Règlement diff." Suffix="F" Margin="0,0,2,0"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding ExchangePaymentMode}" Margin="2,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBox Grid.Column="2" Text="{Binding ExchangePaymentReference}" controls:Placeholder.Text="Réf." Margin="2,0,0,0"/>
                </Grid>
                <TextBox Text="{Binding Reason}" controls:Placeholder.Text="Motif du retour (obligatoire)" Margin="0,0,0,4"/>
                <controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable" Margin="0,0,0,6"/>
                <Button Content="Valider le retour ou échange" Command="{Binding ReturnExchangeCommand}" Style="{StaticResource PrimaryButton}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Annulation -->
          <TabItem Header="Annulation">
            <StackPanel Margin="4,6">
              <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <TextBlock Text="Annule l'intégralité de la vente : les articles sont réintégrés et les règlements contre-passés." Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap"/>
              </Border>
              <TextBlock Text="Numéro de vente à annuler" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding SaleNumber}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TerracottaDark}" Margin="0,0,0,8"/>
              <TextBox Text="{Binding Reason}" controls:Placeholder.Text="Motif obligatoire d'annulation" Margin="0,0,0,6"/>
              <controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable" Margin="0,0,0,10"/>
              <Button Content="Annuler définitivement la vente" Command="{Binding CancelSaleCommand}" Style="{StaticResource DangerButton}"/>
            </StackPanel>
          </TabItem>

          <!-- Proforma -->
          <TabItem Header="Proforma">
            <StackPanel Margin="4,6">
              <TextBlock Text="Établir une facture proforma / devis sans mouvement de caisse." Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
              <TextBox Text="{Binding ProformaDescription}" controls:Placeholder.Text="Description de la commande..." Margin="0,0,0,6"/>
              <controls:KeypadField Value="{Binding ProformaTotal}" Title="Total Proforma" Suffix="FCFA" Margin="0,0,0,10"/>
              <Button Content="Créer la proforma" Command="{Binding ProformaCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Aperçu du document sélectionné -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Aperçu visuel du document" Style="{StaticResource Eyebrow}" Margin="2,0,0,6"/>
          <Border Grid.Row="1" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding PreviewLines}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11" LineHeight="15"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Sélectionnez un document dans la table pour afficher son contenu." Style="{StaticResource HelperText}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,20" Visibility="{Binding NoPreview, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="12,6" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</UserControl>
