<UserControl x:Class="BoutiqueFashion.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- En-tête -->
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="COMMANDES DU SITE" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="Demandes à rappeler puis encaisser" Style="{StaticResource SectionTitle}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Voir l'historique" Command="{Binding ToggleClosedCommand}" MinWidth="160"/>
        <Button Content="Actualiser" Command="{Binding RefreshCommand}" MinWidth="130"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Liste -->
      <Border Style="{StaticResource Card}" Padding="0" Margin="4">
        <Grid>
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0" AutomationProperties.Name="Commandes reçues">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Number}" Width="140"/>
              <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="*"/>
              <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}" Width="130"/>
              <DataGridTextColumn Header="REÇUE" Binding="{Binding PlacedAt, StringFormat=dd/MM HH:mm}" Width="100"/>
              <DataGridTemplateColumn Header="ÉTAT" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" Background="{StaticResource Ivory}">
                      <TextBlock Text="{Binding Status, Converter={StaticResource EnumFr}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalXof, StringFormat={}{0:N0}}" Width="110" ElementStyle="{StaticResource Money}"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Aucune commande pour l'instant. Elles arriveront ici dès qu'une cliente en passera une depuis le site."
                     Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="24,70,24,0" TextAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}"/>
        </Grid>
      </Border>

      <!-- Détail et actions -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Ni Style ni Visibility en attribut : le premier lèverait MC3024, le second
                 l'emporterait sur le déclencheur et figerait le bloc. -->
            <TextBlock Text="Sélectionnez une commande pour la traiter." TextAlignment="Center" Margin="2,40,2,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Selected.CustomerName}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Selected.Phone}" Style="{StaticResource HelperText}"/>
              <TextBlock Text="{Binding Selected.Number, StringFormat=Référence {0}}" Style="{StaticResource HelperText}" Margin="0,0,0,10"/>

              <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Selected.Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Style="{StaticResource Money}" FontSize="13" Margin="8,0,0,0">
                            <Run Text="{Binding Quantity, StringFormat={}{0:0.##}, Mode=OneWay}"/>
                            <Run Text="×"/>
                            <Run Text="{Binding UnitPriceXof, StringFormat={}{0:N0}, Mode=OneWay}"/>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator Margin="0,8"/>
                  <Grid>
                    <TextBlock Text="Total annoncé" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding Selected.TotalXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Le mot de la cliente n'apparaît que s'il existe : un convertisseur booléen sur
                   une chaîne ne dirait rien, un déclencheur sur la valeur vide le dit. -->
              <Border Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Selected.Note}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      <DataTrigger Binding="{Binding Selected.Note}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Selected.Note}" Foreground="{StaticResource Info}" FontSize="12" TextWrapping="Wrap"/>
              </Border>

              <!-- L'encaissement ouvre la vente avec le panier prêt. C'est l'enregistrement de
                   cette vente qui fera passer la commande en « traitée », jamais ce bouton. -->
              <Button Content="Encaisser cette commande" Command="{Binding CollectCommand}" Style="{StaticResource HeroButton}"
                      Margin="0,0,0,8" IsEnabled="{Binding CanCollect}"/>
              <TextBlock Text="Le panier s'ouvre déjà rempli. La commande passera en « traitée » une fois la vente enregistrée."
                         Style="{StaticResource HelperText}" Margin="2,0,2,10"
                         Visibility="{Binding CanCollect, Converter={StaticResource BoolToVis}}"/>

              <Button Content="Marquer comme livrée" Command="{Binding DeliverCommand}" MinHeight="48"
                      IsEnabled="{Binding CanDeliver}"/>
              <TextBlock Text="Disponible une fois la vente encaissée : on ne remet pas une marchandise qui n'a pas été payée."
                         Style="{StaticResource HelperText}" Margin="2,6,2,0"/>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="2,12,2,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
