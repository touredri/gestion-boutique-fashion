<UserControl x:Class="BoutiqueFashion.App.Views.SaleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="clr-namespace:BoutiqueFashion.Domain;assembly=BoutiqueFashion.Domain" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="520"/><ColumnDefinition Width="0.9*" MinWidth="390" MaxWidth="520"/></Grid.ColumnDefinitions>
    
    <!-- Colonne Gauche : Recherche & Grille Produits -->
    <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      
      <!-- Barre de recherche et filtre -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Rechercher un produit" Style="{StaticResource FieldLabel}" Margin="4,0,4,2"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Scanner ou saisir..." KeyDown="SearchBox_OnKeyDown" AutomationProperties.Name="Recherche produit"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" Margin="4,0,4,2"/>
            <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" AutomationProperties.Name="Filtrer par catégorie"/>
          </StackPanel>
          <Button Grid.Column="2" Content="Rechercher" Command="{Binding SearchProductsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="8,0,0,0" MinWidth="110"/>
        </Grid>
      </Border>

      <!-- Grille des cartes produits -->
      <ListBox Grid.Row="1" ItemsSource="{Binding Products}" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Width="185" Height="195" Margin="5" Padding="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                      <Setter Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border CornerRadius="8" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,6" HorizontalAlignment="Stretch" ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill">
                      <Image.Style>
                        <Style TargetType="Image">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                      </Image.Style>
                    </Image>
                    <Border Background="{StaticResource Danger}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="{Binding IsOutOfStock, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Rupture" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1">
                  <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="36" LineHeight="17"/>
                  <TextBlock Text="{Binding Sku}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,4,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding PriceXof, StringFormat={}{0:N0} F}" Foreground="{StaticResource Terracotta}" FontSize="14" FontWeight="Bold" Style="{StaticResource Money}" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Background="{StaticResource Ivory}" CornerRadius="6" Padding="6,2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <TextBlock Text="{Binding QuantityOnHand, StringFormat=Qté: {0:0.###}}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                  </Border>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Colonne Droite : Panier & Encaissement -->
    <Border Grid.Column="1" Style="{StaticResource RaisedCard}" Margin="0" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="230"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        
        <!-- En-tête Panier -->
        <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="PANIER EN COURS" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
              <TextBlock Text="{Binding PayableXof, StringFormat={}{0:N0} FCFA}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Terracotta}" Style="{StaticResource Money}"/>
              <TextBlock Text="{Binding CashSessionState}" FontSize="11" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCashOpen}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource TerracottaDark}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Vider" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" MinWidth="68" MinHeight="36" VerticalAlignment="Center" AutomationProperties.Name="Vider le panier"/>
          </Grid>
        </Border>

        <!-- Liste des articles dans le panier -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" Margin="10,6" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,3">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                  <!-- Ligne 1 : désignation, prix unitaire, retirer -->
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Text="{Binding UnitPriceXof, StringFormat={}{0:N0} F}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <Button Grid.Column="2" Content="×" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Danger}" Background="Transparent" BorderBrush="Transparent" Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="0" ToolTip="Retirer l'article" AutomationProperties.Name="Retirer l'article" VerticalAlignment="Center" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                  </Grid>

                  <!-- Ligne 2 : quantité, remise, total -->
                  <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="−" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}" Background="Transparent" BorderBrush="Transparent" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Diminuer la quantité"/>
                        <TextBlock Text="{Binding Quantity, StringFormat=× {0}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" MinWidth="28" TextAlignment="Center"/>
                        <Button Content="+" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TerracottaDark}" Background="Transparent" BorderBrush="Transparent" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Augmenter la quantité"/>
                      </StackPanel>
                    </Border>

                    <!-- Remise en FCFA : champ unique, le « − » est rendu à côté du texte éditable -->
                    <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" Width="88" Height="34" Margin="6,0,0,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource Paper}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDiscountTooLarge}" Value="True">
                              <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                              <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid Margin="6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                        <Grid Grid.Column="1">
                          <TextBlock Text="Remise" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="3,0" IsHitTestVisible="False" Visibility="{Binding DiscountValue, Converter={StaticResource ZeroToVis}}"/>
                          <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Height="30" MinHeight="0" Margin="0" Padding="3,0" FontSize="13" AutomationProperties.Name="Remise sur cet article en FCFA"/>
                        </Grid>
                      </Grid>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding TotalXof, StringFormat={}{0:N0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" FontSize="16" FontWeight="Bold" Margin="6,0,0,0"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Encaissement -->
        <Border Grid.Row="2" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="8,4,8,8">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <!-- Paiement, remise et paiement mixte sur une seule ligne -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Moyen de paiement" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" AutomationProperties.Name="Moyen de paiement"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Remise" Style="{StaticResource FieldLabel}"/>
                  <controls:KeypadField Value="{Binding DiscountPercent}" Suffix="%" Placeholder="0 %" AutomationProperties.Name="Remise en pourcentage"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Paiement mixte" Style="{StaticResource FieldLabel}"/>
                  <Button Content="+ Ajouter" Command="{Binding AddPaymentCommand}" MinWidth="100" Margin="4" AutomationProperties.Name="Ajouter un paiement mixte"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPaymentMode}" Value="{x:Static domain:PaymentMode.Credit}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                  <Button Content="+7 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="7"/>
                  <Button Content="+15 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="15"/>
                  <Button Content="+30 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="30"/>
                  <Button Content="+60 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="60"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CreditDueDate}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPaymentMode}" Value="{x:Static domain:PaymentMode.Credit}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <!-- Détail des paiements mixtes -->
              <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Payments}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Mode de paiement"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><controls:KeypadField Grid.Column="1" Value="{Binding AmountXof}" Placeholder="Montant reçu" AutomationProperties.Name="Montant reçu" Margin="2,0"/><TextBox Grid.Column="2" Text="{Binding Reference}" controls:Placeholder.Text="Référence (optionnel)" AutomationProperties.Name="Référence du paiement"/><Button Grid.Column="3" Content="×" MinWidth="0" Width="38" ToolTip="Retirer ce paiement" AutomationProperties.Name="Retirer ce paiement" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemovePaymentCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding ChangePreview, StringFormat=Monnaie à rendre : {0:N0} FCFA}" FontWeight="SemiBold" Foreground="{StaticResource Success}" HorizontalAlignment="Right" Margin="4,2,4,0"/>
              </StackPanel>

              <!-- Client et type de document -->
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Client" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding SelectedCustomerChoice}" AutomationProperties.Name="Client">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid MinWidth="170">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Document" Style="{StaticResource FieldLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Reçu" MinWidth="76" Command="{Binding ChooseReceiptCommand}" AutomationProperties.Name="Imprimer un reçu">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding PrintInvoice}" Value="True"><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Facture" MinWidth="76" Command="{Binding ChooseInvoiceCommand}" AutomationProperties.Name="Imprimer une facture">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PrintInvoice}" Value="True"><Setter Property="Background" Value="{StaticResource Terracotta}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- Imprimante et PIN (le PIN n'apparaît qu'avec une remise ou un crédit) -->
              <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Imprimante" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" AutomationProperties.Name="Imprimante"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="152" Visibility="{Binding IsManagerPinRequired, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/>
                  <controls:KeypadField Value="{Binding ManagerPin}" Mask="True" AutomationProperties.Name="PIN responsable"/>
                </StackPanel>
              </Grid>

              <Button Grid.Row="5" Content="Encaisser et imprimer" Command="{Binding CompleteCommand}" Style="{StaticResource HeroButton}" Margin="4,6,4,2"/>
              <TextBlock Grid.Row="6" Text="{Binding Status}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="4,0,4,2" AutomationProperties.LiveSetting="Polite"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Popup de création rapide d'un client -->
    <Border Grid.ColumnSpan="2" Margin="-16" Background="#99202522" Visibility="{Binding IsCustomerDialogOpen, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource RaisedCard}" Width="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="NOUVEAU CLIENT" Style="{StaticResource Eyebrow}" Margin="4,0,4,4"/>
          <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom du client" AutomationProperties.Name="Nom du nouveau client"/>
          <TextBlock Text="Numéro" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Téléphone" AutomationProperties.Name="Téléphone du nouveau client"/>
          <TextBlock Text="{Binding CustomerDialogError}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="4,6,4,0"/>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Annuler" Command="{Binding CancelCustomerDialogCommand}"/>
            <Button Grid.Column="1" Content="Enregistrer" Command="{Binding SaveCustomerCommand}" Style="{StaticResource PrimaryButton}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
