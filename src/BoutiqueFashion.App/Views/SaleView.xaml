<UserControl x:Class="BoutiqueFashion.App.Views.SaleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="clr-namespace:BoutiqueFashion.Domain;assembly=BoutiqueFashion.Domain" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,8,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Rechercher ou scanner (nom, SKU, code-barres)" Style="{StaticResource FieldLabel}" Margin="4,0,4,1"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom, SKU ou code-barres" KeyDown="SearchBox_OnKeyDown" AutomationProperties.Name="Recherche produit"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" Margin="4,0,4,1"/><ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" AutomationProperties.Name="Filtrer par catégorie"/></StackPanel>
          <Button Grid.Column="2" Content="Rechercher" Command="{Binding SearchProductsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
      <ListBox Grid.Row="1" ItemsSource="{Binding Products}" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate>
          <Button Width="168" Height="178" Margin="4" Padding="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsOutOfStock}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers></Style></Button.Style>
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Height="78" CornerRadius="8" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                <Grid>
                  <Image Source="{Binding PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" Margin="3">
                    <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style>
                  </Image>
                  <Border Background="{StaticResource Danger}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="{Binding IsOutOfStock, Converter={StaticResource BoolToVis}}"><TextBlock Text="Rupture" Foreground="White" FontSize="10" FontWeight="Bold"/></Border>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1"><TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding Sku}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,1,0,0"/></StackPanel>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PriceXof, StringFormat={}{0:N0} FCFA}" Foreground="{StaticResource Terracotta}" FontSize="14" Style="{StaticResource Money}"/><TextBlock Grid.Column="1" Text="{Binding QuantityOnHand, StringFormat=Stock : {0:0.###}}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></Grid>
            </Grid>
          </Button>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Border Grid.Column="1" Style="{StaticResource RaisedCard}" Margin="0" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="16,10,14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="PANIER EN COURS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PayableXof, StringFormat={}{0:N0} FCFA}" FontSize="24" Foreground="{StaticResource Terracotta}" Style="{StaticResource Money}"/><TextBlock Text="{Binding CashSessionState}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsCashOpen}" Value="False"><Setter Property="Foreground" Value="{StaticResource TerracottaDark}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
          <Button Grid.Column="1" Content="Vider" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" MinWidth="64" VerticalAlignment="Top" AutomationProperties.Name="Vider le panier"/>
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" Margin="10,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Button Content="−" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Background="Transparent" BorderBrush="Transparent" Width="46" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Diminuer la quantité"/>
                  <TextBlock Text="{Binding Quantity, StringFormat=× {0}}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0" MinWidth="34" TextAlignment="Center"/>
                  <Button Content="+" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TerracottaDark}" Background="Transparent" BorderBrush="Transparent" Width="46" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Augmenter la quantité"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UnitPriceXof, StringFormat={}{0:N0} FCFA / unité}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Remise" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <ComboBox ItemsSource="{Binding DiscountKindLabels}" SelectedItem="{Binding DiscountKindLabel}" Width="110" Margin="0,0,4,0" AutomationProperties.Name="Type de remise article"/>
                  <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0" controls:Placeholder.Text="0" AutomationProperties.Name="Valeur de remise"/>
                  <TextBlock Text="{Binding DiscountAmountXof, StringFormat=- {0:N0}}" Foreground="{StaticResource Danger}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding TotalXof, StringFormat={}{0:N0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" FontSize="16"/>
              <Button Grid.Column="3" Content="×" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Danger}" Background="Transparent" BorderBrush="Transparent" Width="36" Height="44" MinWidth="0" MinHeight="0" Padding="0" Margin="0" ToolTip="Retirer l'article" AutomationProperties.Name="Retirer l'article" VerticalAlignment="Center" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
            </Grid>
          </Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TabControl Grid.Row="2" Height="440" Margin="8,6,8,8" Padding="0">
          <TabItem Header="Encaissement">
            <Grid Margin="6,2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Moyen de paiement" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" AutomationProperties.Name="Moyen de paiement"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding DiscountPercent}" Title="Remise %" Suffix="%" Margin="0,0,4,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPaymentMode}" Value="{x:Static domain:PaymentMode.Credit}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                  <Button Content="+7 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="7"/>
                  <Button Content="+15 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="15"/>
                  <Button Content="+30 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="30"/>
                  <Button Content="+60 j" MinWidth="44" Command="{Binding SetCreditDueCommand}" CommandParameter="60"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CreditDueDate}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPaymentMode}" Value="{x:Static domain:PaymentMode.Credit}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Payments}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Mode de paiement"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><controls:KeypadField Grid.Column="1" Value="{Binding AmountXof}" Title="Montant reçu" Margin="2,0"/><TextBox Grid.Column="2" Text="{Binding Reference}" controls:Placeholder.Text="Référence (optionnel)" AutomationProperties.Name="Référence du paiement"/><Button Grid.Column="3" Content="×" MinWidth="0" Width="38" ToolTip="Retirer ce paiement" AutomationProperties.Name="Retirer ce paiement" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemovePaymentCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button Content="+ Paiement mixte" Command="{Binding AddPaymentCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="2" Text="{Binding ChangePreview, StringFormat=Monnaie à rendre : {0:N0} FCFA}" FontWeight="SemiBold" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" AutomationProperties.Name="Imprimante"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <Button Grid.Column="1" Content="Reçu" MinWidth="84" Command="{Binding ChooseReceiptCommand}" AutomationProperties.Name="Imprimer un reçu">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding PrintInvoice}" Value="True"><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Grid.Column="2" Content="Facture" MinWidth="84" Command="{Binding ChooseInvoiceCommand}" AutomationProperties.Name="Imprimer une facture">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PrintInvoice}" Value="True"><Setter Property="Background" Value="{StaticResource Terracotta}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
              </Grid>
              <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/>
                <TextBlock Grid.Column="1" Text="Requis uniquement pour le crédit ou une remise de plus de 10 %." Style="{StaticResource HelperText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
              <Button Grid.Row="5" Content="Encaisser et imprimer" Command="{Binding CompleteCommand}" Style="{StaticResource HeroButton}" Margin="4,2,4,2"/>
              <TextBlock Grid.Row="6" Text="{Binding Status}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="4,0,4,4" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
          </TabItem>
          <TabItem Header="Client">
            <Grid Margin="8,6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom ou téléphone" AutomationProperties.Name="Recherche client"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Margin="4,4" Style="{StaticResource HelperText}"><Run Text="Client sélectionné : "/><Run Text="{Binding SelectedCustomer.Name, Mode=OneWay, FallbackValue=aucun (vente comptoir)}"/></TextBlock>
              <StackPanel Grid.Row="3">
                <TextBlock Text="NOUVEAU CLIENT (OPTIONNEL)" Style="{StaticResource Eyebrow}" Margin="4,2,4,0"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom du client" AutomationProperties.Name="Nom du nouveau client"/>
                  <TextBox Grid.Column="1" Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Téléphone" AutomationProperties.Name="Téléphone du nouveau client"/>
                </Grid>
                <TextBlock Text="Sans client sélectionné ci-dessus, un client est créé avec ces informations." Style="{StaticResource HelperText}" Margin="4,0,4,4"/>
              </StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="Clôture caisse">
            <StackPanel Margin="8,6">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding OpeningFloat}" Title="Fond initial" Suffix="FCFA"/>
                <Button Grid.Column="1" Content="Ouvrir la caisse" Command="{Binding OpenCashCommand}" VerticalAlignment="Center"/>
              </Grid>
              <controls:KeypadField Value="{Binding CountedCash}" Title="Espèces comptées" Suffix="FCFA"/>
              <TextBox Text="{Binding CashDifferenceReason}" ToolTip="Motif de l'écart (obligatoire si écart)"/>
              <Button Content="Clôturer la caisse" Command="{Binding CloseCashCommand}" Style="{StaticResource DangerButton}" Margin="4,4,4,2"/>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
