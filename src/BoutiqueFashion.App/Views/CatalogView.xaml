<UserControl x:Class="BoutiqueFashion.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="1.5*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <Grid Margin="4,0,4,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="1 · PRODUIT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Modèle commercial (vêtement, chaussure ou accessoire)" Style="{StaticResource SectionTitle}"/></StackPanel><TextBlock Grid.Column="1" Text="Sélectionnez une ligne ci-dessous pour la modifier" Style="{StaticResource HelperText}" VerticalAlignment="Center"/></Grid>
          <WrapPanel>
            <StackPanel Width="200"><TextBlock Text="Nom du produit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Width="130"><TextBlock Text="Type d'article" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding SelectedType}"/></StackPanel>
            <StackPanel Width="140"><TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Category}"/></StackPanel>
            <StackPanel Width="140"><TextBlock Text="Sous-catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SubCategory}"/></StackPanel>
            <StackPanel Width="130"><TextBlock Text="Marque" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Brand}"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Genre/public" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Gender}" ToolTip="Homme, femme, enfant…"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Saison" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Season}"/></StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding ProductNotice}" Style="{StaticResource HelperText}" Foreground="{StaticResource TerracottaDark}" Margin="4,2,4,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="2 · VARIANTES ET TARIFS" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Matrice couleurs × tailles — les tailles recommandées se remplissent selon le type" Style="{StaticResource HelperText}" Margin="4,0,4,6"/>
          <WrapPanel>
            <StackPanel Width="140"><TextBlock Text="Préfixe SKU" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MatrixPrefix}" ToolTip="Ex. CHE-CLA"/></StackPanel>
            <StackPanel Width="220"><TextBlock Text="Couleurs (virgules)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MatrixColors}" ToolTip="Ex. Blanc, Bleu"/></StackPanel>
            <StackPanel Width="260"><TextBlock Text="Tailles / pointures (virgules)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MatrixSizes}"/></StackPanel>
            <StackPanel Width="100"><TextBlock Text="Stock initial" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MatrixQuantity}"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Coût FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Cost}"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Prix FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Price}"/></StackPanel>
            <Button Content="Créer la matrice de variantes" Command="{Binding CreateMatrixCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
          </WrapPanel>
          <WrapPanel Margin="0,6,0,0">
            <StackPanel Width="150"><TextBlock Text="SKU (variante seule)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sku}"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Taille / pointure" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VariantSize}"/></StackPanel>
            <StackPanel Width="110"><TextBlock Text="Couleur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VariantColor}"/></StackPanel>
            <StackPanel Width="120"><TextBlock Text="Prix promo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PromotionPrice}"/></StackPanel>
            <StackPanel Width="105"><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="CatalogPin_OnPasswordChanged"/></StackPanel>
            <Button Content="Ajouter 1 variante" Command="{Binding CreateCommand}" VerticalAlignment="Bottom"/>
            <Button Content="Enregistrer les modifications" Command="{Binding UpdateCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
            <Button Content="Archiver" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButton}" VerticalAlignment="Bottom"/>
          </WrapPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="5"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="3 · SUIVI EN BOUTIQUE" Style="{StaticResource Eyebrow}"/>
          <WrapPanel>
            <StackPanel Width="240"><TextBlock Text="Photo du produit" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PhotoPath}" ToolTip="Chemin de la photo" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowsePhoto_OnClick" Margin="4,0,0,0" VerticalAlignment="Stretch" ToolTip="Choisir une image"/></Grid></StackPanel>
            <StackPanel Width="130"><TextBlock Text="Matière" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Material}"/></StackPanel>
            <StackPanel Width="140"><TextBlock Text="Rayon / emplacement" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Location}"/></StackPanel>
            <StackPanel Width="160"><TextBlock Text="Fournisseur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier}"/></StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="6,12,6,6"><DataGrid.Columns><DataGridTemplateColumn Header="PHOTO" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding Product.PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" Margin="2" ToolTip="{Binding Product.Name}"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PRODUIT" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Product.Type}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="TAILLE" Binding="{Binding Size}"/><DataGridTextColumn Header="COULEUR" Binding="{Binding Color}"/><DataGridTextColumn Header="STOCK" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="PRIX" Binding="{Binding PriceXof,StringFormat={}{0:N0} FCFA}"/><DataGridTextColumn Header="PROMO" Binding="{Binding PromotionalPriceXof,StringFormat={}{0:N0} FCFA}"/></DataGrid.Columns></DataGrid>
  </Grid>
</UserControl>
