<UserControl x:Class="BoutiqueFashion.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="14"><StackPanel><Grid Margin="4,0,4,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FICHE ARTICLE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Créer ou modifier un produit" Style="{StaticResource SectionTitle}"/></StackPanel><TextBlock Grid.Column="1" Text="Sélectionnez une ligne pour la modifier" Style="{StaticResource HelperText}" VerticalAlignment="Center"/></Grid><WrapPanel><StackPanel Width="176"><TextBlock Text="Nom du produit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProductName}"/></StackPanel><StackPanel Width="135"><TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Category}"/></StackPanel><StackPanel Width="126"><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sku}"/></StackPanel><StackPanel Width="110"><TextBlock Text="Coût FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Cost}"/></StackPanel><StackPanel Width="110"><TextBlock Text="Prix FCFA" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Price}"/></StackPanel><StackPanel Width="120"><TextBlock Text="Prix promo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PromotionPrice}"/></StackPanel><StackPanel Width="240"><TextBlock Text="Photo du produit" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PhotoPath}" ToolTip="Chemin de la photo" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowsePhoto_OnClick" Margin="4,0,0,0" VerticalAlignment="Stretch" ToolTip="Choisir une image"/></Grid></StackPanel><StackPanel Width="105"><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="CatalogPin_OnPasswordChanged"/></StackPanel></WrapPanel><WrapPanel HorizontalAlignment="Right"><Button Content="Ajouter" Command="{Binding CreateCommand}"/><Button Content="Archiver" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButton}"/><Button Content="Enregistrer les modifications" Command="{Binding UpdateCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" Margin="5"/></StackPanel></Border><DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="6,12,6,6"><DataGrid.Columns><DataGridTemplateColumn Header="PHOTO" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding Product.PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" Margin="2" ToolTip="{Binding Product.Name}"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PRODUIT" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="STOCK" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="PRIX" Binding="{Binding PriceXof,StringFormat={}{0:N0} FCFA}"/><DataGridTextColumn Header="PROMO" Binding="{Binding PromotionalPriceXof,StringFormat={}{0:N0} FCFA}"/></DataGrid.Columns></DataGrid></Grid></UserControl>
