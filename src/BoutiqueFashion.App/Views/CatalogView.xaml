<UserControl x:Class="BoutiqueFashion.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="16">
    <!-- Trois rangées : en-tête, bandeau du mode consultation, onglets. -->
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    
    <!-- En-tête -->
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="PRODUITS &amp; CATALOGUE" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="Gestion des articles, variantes et prix" Style="{StaticResource SectionTitle}"/>
      </StackPanel>
      <!-- L'import de masse écrit directement au catalogue : il reste au gérant. Le vendeur garde
           l'onglet de saisie, qui n'envoie qu'une proposition à valider. -->
      <Button Grid.Column="1" Content="Importer un CSV" Command="{Binding BrowseImportFileCommand}" VerticalAlignment="Center" MinWidth="130">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Session.IsManager}" Value="True"/>
                  <Condition Binding="{Binding IsCatalogEditable}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="4,0,4,10"
            Visibility="{Binding IsCatalogReadOnly, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Text="Catalogue géré depuis l'application mobile. Les articles et les prix redescendent ici automatiquement ; le stock, lui, reste piloté depuis cette caisse."
                   Foreground="{StaticResource Info}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" Padding="0">
      <!-- Onglet 1 : Ajouter / Modifier. Disparaît dès que le serveur est maître du catalogue. -->
      <TabItem Header="Ajouter / Modifier un produit" Visibility="{Binding IsCatalogEditable, Converter={StaticResource BoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
          <StackPanel>
            <!-- Bloc 1 : Informations générales -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="1 · Informations produit" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10" Visibility="{Binding Session.IsSeller, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Votre proposition sera enregistrée en brouillon. Elle n'entrera au catalogue et en stock qu'après validation par le gérant." Foreground="{StaticResource Info}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="Nom du produit *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Ex: Robe longue en soie"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Type d'article" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding SelectedType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Genre / Public" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="Description courte" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Description}" controls:Placeholder.Text="Détails, coupe, style..."/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Marque / Créateur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Brand}" controls:Placeholder.Text="Ex: Zara, Wax..."/></StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Stock initial" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding MatrixQuantity}" Placeholder="0" AutomationProperties.Name="Stock initial"/></StackPanel>
                  <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Coût unitaire *" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Cost}" Suffix="FCFA" Placeholder="Coût d'achat" AutomationProperties.Name="Coût unitaire"/></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock Text="Prix de vente *" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Price}" Suffix="FCFA" Placeholder="Prix public" AutomationProperties.Name="Prix de vente"/></StackPanel>
                </Grid>
                <TextBlock Text="{Binding ProductNotice}" Style="{StaticResource HelperText}" Foreground="{StaticResource TerracottaDark}" Margin="4,4,4,0"/>
              </StackPanel>
            </Border>

            <!-- Bloc 2 : Variantes et Tarifs -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="2 · Variantes et tarification" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="+ Ajouter une variante" Command="{Binding AddVariantRowCommand}" MinWidth="170" AutomationProperties.Name="Ajouter une ligne de variante"/>
                </Grid>
                <TextBlock Text="Le SKU est généré automatiquement à partir du nom du produit. Le coût et le prix sont hérités du produit : laissez-les vides sauf si cette variante a un tarif différent." Style="{StaticResource HelperText}" Margin="4,0,4,6"/>

                <ItemsControl ItemsSource="{Binding VariantRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,6,0"><TextBlock Text="Coût unitaire" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Cost}" Suffix="FCFA" Placeholder="{Binding DataContext.Cost, RelativeSource={RelativeSource AncestorType=ItemsControl}}" AutomationProperties.Name="Coût de la variante"/></StackPanel>
                          <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Prix de vente" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Price}" Suffix="FCFA" Placeholder="{Binding DataContext.Price, RelativeSource={RelativeSource AncestorType=ItemsControl}}" AutomationProperties.Name="Prix de la variante"/></StackPanel>
                          <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Taille" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.SizeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Size}"/></StackPanel>
                          <StackPanel Grid.Column="3" Margin="0,0,6,0"><TextBlock Text="Couleur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Color}" controls:Placeholder.Text="Couleur"/></StackPanel>
                          <StackPanel Grid.Column="4" Margin="0,0,6,0"><TextBlock Text="Matière" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.MaterialOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Material}"/></StackPanel>
                          <StackPanel Grid.Column="5" Margin="0,0,6,0">
                            <TextBlock Text="Photo" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBox Text="{Binding PhotoPath}" IsReadOnly="True"/>
                              <Button Grid.Column="1" Content="…" Click="BrowseRowPhoto_OnClick" MinWidth="34" Margin="4,0,0,0" ToolTip="Parcourir la photo"/>
                            </Grid>
                          </StackPanel>
                          <Button Grid.Column="6" Content="×" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Danger}" Background="Transparent" BorderBrush="Transparent" Width="32" Height="36" MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Bottom" Margin="0,0,0,4" Command="{Binding DataContext.RemoveVariantRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Retirer cette variante"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Actions de validation -->
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Content="{Binding SaveButtonLabel}" Command="{Binding SaveVariantsCommand}" Style="{StaticResource HeroButton}" MinWidth="180" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Onglet Brouillons : propositions des vendeurs à valider -->
      <TabItem Header="{Binding DraftsTabHeader}" Visibility="{Binding IsCatalogEditable, Converter={StaticResource BoolToVis}}">
        <Grid Margin="0,4,0,0">
          <ItemsControl ItemsSource="{Binding Drafts}">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="{Binding CategoryName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Lines.Count, Mode=OneWay}"/><Run Text=" variante(s) · proposé le "/><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=dd/MM/yyyy à HH:mm}"/>
                      </TextBlock>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0">
                        <Run Text="Coût "/><Run Text="{Binding CostXof, Mode=OneWay, StringFormat={}{0:N0} F}"/><Run Text=" · Prix "/><Run Text="{Binding PriceXof, Mode=OneWay, StringFormat={}{0:N0} F}"/><Run Text=" · Stock initial "/><Run Text="{Binding InitialQuantity, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refuser" Command="{Binding DataContext.RejectDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" MinWidth="110" Margin="8,0"/>
                    <Button Grid.Column="2" Content="Valider et publier" Command="{Binding DataContext.ApproveDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" MinWidth="160"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Aucune proposition en attente." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,40,16,0" IsHitTestVisible="False" Visibility="{Binding Drafts.Count, Converter={StaticResource ZeroToVis}}"/>
        </Grid>
      </TabItem>

      <!-- Onglet 2 : Liste des produits -->
      <TabItem Header="Liste des produits enregistrés">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          
          <!-- Prévisualisation import CSV -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12" Visibility="{Binding HasImportPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ImportRowsCount, StringFormat={}{0} lignes prêtes à être importées}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Lancer l'importation" Command="{Binding RunImportCommand}" Style="{StaticResource PrimaryButton}" MinWidth="160"/>
              </Grid>
              <DataGrid ItemsSource="{Binding ImportIssues}" MaxHeight="120" Margin="0,8,0,0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="LIGNE" Binding="{Binding Line}" Width="70"/>
                  <DataGridTextColumn Header="PROBLÈME DÉTECTÉ" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Barre d'action sur sélection : modifier, archiver et supprimer sont des actions gérant. -->
          <!-- Style porté par l'élément et non l'attribut : les deux à la fois lèvent MC3024. -->
          <Border Grid.Row="1" Margin="0,0,0,8" Padding="12">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Session.IsManager}" Value="True"/>
                      <Condition Binding="{Binding IsCatalogEditable}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Button Content="Modifier le produit" Command="{Binding EditSelectedCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0,0,8,0"/>
                <Button Content="Archiver" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButton}" MinWidth="100" Margin="0,0,8,0"/>
                <Button Content="Supprimer" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" MinWidth="100"/>
              </StackPanel>
              <TextBlock Text="Sélectionnez une ligne dans le tableau ci-dessous pour modifier ou archiver." Style="{StaticResource HelperText}" VerticalAlignment="Center" Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}"/>
            </Grid>
          </Border>

          <!-- Tableau des produits -->
          <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="PHOTO" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Width="48" Height="48" CornerRadius="6" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                      <Image Source="{Binding PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" ToolTip="{Binding Product.Name}">
                        <Image.Style>
                          <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                          </Style>
                        </Image.Style>
                      </Image>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="PRODUIT" Binding="{Binding Product.Name}" Width="*"/>
              <DataGridTextColumn Header="TYPE" Binding="{Binding Product.Type, Converter={StaticResource EnumFr}}" Width="110"/>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
              <DataGridTextColumn Header="TAILLE" Binding="{Binding Size}" Width="80"/>
              <DataGridTextColumn Header="COULEUR" Binding="{Binding Color}" Width="90"/>
              <DataGridTextColumn Header="STOCK" Binding="{Binding QuantityOnHand}" Width="75"/>
              <DataGridTextColumn Header="PRIX" Binding="{Binding PriceXof, StringFormat={}{0:N0} F}" Width="110"/>
              <DataGridTextColumn Header="MARGE" Binding="{Binding MarginXof, StringFormat={}{0:N0} F}" Width="100"/>
              <DataGridTextColumn Header="PROMO" Binding="{Binding PromotionalPriceXof, StringFormat={}{0:N0} F}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="Aucun produit enregistré. Créez-en un dans l'onglet précédent." Style="{StaticResource HelperText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,58,16,0" TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
