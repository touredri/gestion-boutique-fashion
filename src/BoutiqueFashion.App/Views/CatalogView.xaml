<UserControl x:Class="BoutiqueFashion.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="4,0,4,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="PRODUITS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Catalogue de la boutique" Style="{StaticResource SectionTitle}"/></StackPanel>
      <Button Grid.Column="1" Content="Import CSV" Command="{Binding BrowseImportFileCommand}" VerticalAlignment="Center"/>
    </Grid>
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="0">
      <TabItem Header="  Ajouter un produit  " Padding="14,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock Text="1 · PRODUIT" Style="{StaticResource Eyebrow}"/>
                <WrapPanel>
                  <StackPanel Width="200"><TextBlock Text="Nom du produit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nom du produit"/></StackPanel>
                  <StackPanel Width="130"><TextBlock Text="Type d'article" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding SelectedType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                  <StackPanel Width="160"><TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}"/></StackPanel>
                  <StackPanel Width="110"><Button Content="+ Nouvelle catégorie" Command="{Binding ToggleNewCategoryCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel>
                  <StackPanel Width="160" Visibility="{Binding ShowNewCategory, Converter={StaticResource BoolToVis}}"><TextBlock Text="Nouvelle catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewCategoryText, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Nouvelle catégorie"/></StackPanel>
                  <StackPanel Width="140"><TextBlock Text="Sous-catégorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SubCategory}" controls:Placeholder.Text="Sous-catégorie"/></StackPanel>
                  <StackPanel Width="130"><TextBlock Text="Marque" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Brand}" controls:Placeholder.Text="Marque"/></StackPanel>
                  <StackPanel Width="110"><TextBlock Text="Genre/public" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}"/></StackPanel>
                  <StackPanel Width="280"><TextBlock Text="Description courte" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Description}" controls:Placeholder.Text="Description courte"/></StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding ProductNotice}" Style="{StaticResource HelperText}" Foreground="{StaticResource TerracottaDark}" Margin="4,2,4,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock Text="2 · VARIANTES ET TARIFS" Style="{StaticResource Eyebrow}"/>
                <WrapPanel>
                  <StackPanel Width="110"><TextBlock Text="Stock initial" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding MatrixQuantity}" Title="Stock initial"/></StackPanel>
                  <StackPanel Width="120"><TextBlock Text="Coût FCFA" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Cost}" Title="Coût" Suffix="FCFA"/></StackPanel>
                  <StackPanel Width="120"><TextBlock Text="Prix FCFA" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding Price}" Title="Prix" Suffix="FCFA"/></StackPanel>
                </WrapPanel>
                <Button Content="+ Variante" Command="{Binding ToggleVariantEntryCommand}" HorizontalAlignment="Left" Margin="4,8,4,2" AutomationProperties.Name="Afficher la saisie de variante"/>
                <WrapPanel Visibility="{Binding ShowVariantEntry, Converter={StaticResource BoolToVis}}">
                  <StackPanel Width="150"><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sku}" controls:Placeholder.Text="SKU"/></StackPanel>
                  <StackPanel Width="140"><TextBlock Text="Code-barres" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Barcode}" controls:Placeholder.Text="Code-barres"/></StackPanel>
                  <StackPanel Width="120"><TextBlock Text="Taille / pointure" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding VariantSize}"/></StackPanel>
                  <StackPanel Width="120"><TextBlock Text="Couleur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VariantColor}" controls:Placeholder.Text="Couleur"/></StackPanel>
                  <StackPanel Width="140"><TextBlock Text="Matière" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding MaterialOptions}" SelectedItem="{Binding Material}"/></StackPanel>
                  <StackPanel Width="160"><TextBlock Text="Fournisseur" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier}" controls:Placeholder.Text="Fournisseur"/></StackPanel>
                  <StackPanel Width="240"><TextBlock Text="Photo de la variante" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PhotoPath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowsePhoto_OnClick" Margin="4,0,0,0" VerticalAlignment="Stretch"/></Grid></StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Ajouter le produit" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Enregistrer les modifications" Command="{Binding UpdateCommand}"/>
                  <Button Content="Archiver" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButton}"/>
                  <StackPanel Width="170"><TextBlock Text="PIN responsable" Style="{StaticResource FieldLabel}"/><controls:KeypadField Value="{Binding ManagerPin}" Mask="True" Title="PIN responsable"/></StackPanel>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource HelperText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="  Liste des produits  " Padding="14,10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="10" Visibility="{Binding HasImportPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="{Binding ImportRowsCount, StringFormat={}{0} lignes prêtes}" Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                <Button Content="Importer" Command="{Binding RunImportCommand}" Style="{StaticResource PrimaryButton}"/>
              </WrapPanel>
              <DataGrid ItemsSource="{Binding ImportIssues}" MaxHeight="140" Margin="0,6,0,0"><DataGrid.Columns><DataGridTextColumn Header="LIGNE" Binding="{Binding Line}" Width="70"/><DataGridTextColumn Header="PROBLÈME" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="10">
            <WrapPanel>
              <Button Content="Modifier" Command="{Binding EditSelectedCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Archiver" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButton}"/>
              <Button Content="Supprimer" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}"/>
              <TextBlock Text="Sélectionnez une ligne puis choisissez une action." Style="{StaticResource HelperText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </WrapPanel>
          </Border>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,6,0,0"><DataGrid.Columns><DataGridTemplateColumn Header="PHOTO" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding PrimaryImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" Margin="2" ToolTip="{Binding Product.Name}"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PRODUIT" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Product.Type, Converter={StaticResource EnumFr}}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="TAILLE" Binding="{Binding Size}"/><DataGridTextColumn Header="COULEUR" Binding="{Binding Color}"/><DataGridTextColumn Header="STOCK" Binding="{Binding QuantityOnHand}"/><DataGridTextColumn Header="PRIX" Binding="{Binding PriceXof,StringFormat={}{0:N0} FCFA}"/><DataGridTextColumn Header="MARGE" Binding="{Binding MarginXof,StringFormat={}{0:N0} FCFA}"/><DataGridTextColumn Header="PROMO" Binding="{Binding PromotionalPriceXof,StringFormat={}{0:N0} FCFA}"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
