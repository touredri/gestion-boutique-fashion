<Window x:Class="BoutiqueFashion.App.Views.TicketPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aperçu ticket" Height="680" Width="470" WindowStartupLocation="CenterOwner" Background="#F5F0E8">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="PaperHeader" Text="APERÇU TICKET · 80 MM" FontSize="13" FontWeight="SemiBold" Foreground="#6D665F" Margin="2,0,0,2"/>
      <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="#A84F35" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#E3D9CC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TicketLines" FontFamily="Consolas">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" FontSize="{Binding Size}" Foreground="#211E1A"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="2" Content="Fermer" Click="Close_OnClick" MinHeight="48" FontSize="16" Padding="12,8" Background="#A84F35" Foreground="White" BorderThickness="0"/>
  </Grid>
</Window>
