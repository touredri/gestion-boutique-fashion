<Window x:Class="BoutiqueFashion.App.Views.TicketPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aperçu ticket" Height="680" Width="470" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="PaperHeader" Text="Aperçu ticket · 80 mm" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,0,0,2"/>
      <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Terracotta}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TicketLines" FontFamily="Consolas">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" FontSize="{Binding Size}" Foreground="{StaticResource Ink}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="2" Content="Fermer" Click="Close_OnClick" MinHeight="48" FontSize="16" Padding="12,8" Background="{StaticResource Terracotta}" Foreground="White" BorderThickness="0"/>
  </Grid>
</Window>
