<UserControl x:Class="BoutiqueFashion.App.Views.AdvancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- En-tête -->
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AVANCES ET CRÉDITS" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
        <TextBlock Text="Encaisser une tranche, remettre la marchandise soldée" Style="{StaticResource SectionTitle}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Voir les soldées" MinWidth="150" Command="{Binding ToggleSettledCommand}" AutomationProperties.Name="Afficher aussi les avances soldées">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSettled}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Terracotta}"/>
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Actualiser" Command="{Binding RefreshCommand}" MinWidth="120"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Liste des avances en cours -->
      <Border Style="{StaticResource Card}" Padding="0" Margin="4">
        <Grid>
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0" AutomationProperties.Name="Avances en cours">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CLIENT" Binding="{Binding CustomerName}" Width="*"/>
              <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding CustomerPhone}" Width="120"/>
              <DataGridTextColumn Header="VENTE" Binding="{Binding SaleNumber}" Width="130"/>
              <DataGridTemplateColumn Header="TYPE" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource GoldSoft}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReserved}" Value="True">
                              <Setter Property="Background" Value="{StaticResource TerracottaSoft}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Emportée"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsReserved}" Value="True">
                                <Setter Property="Text" Value="Réservée"/>
                                <Setter Property="Foreground" Value="{StaticResource TerracottaDark}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ÉCHÉANCE" Binding="{Binding DueAt, StringFormat=dd/MM/yyyy}" Width="100"/>
              <DataGridTextColumn Header="RESTE DÛ" Binding="{Binding BalanceXof, StringFormat={}{0:N0}}" Width="110" ElementStyle="{StaticResource Money}"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Aucune avance en cours." Style="{StaticResource HelperText}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,70,16,0" TextAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}"/>
        </Grid>
      </Border>

      <!-- Encaissement -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Sélectionnez une avance dans la liste pour encaisser une tranche." Margin="2,40,2,0" TextAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Selected.CustomerName}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Selected.SaleNumber, StringFormat=Vente {0}}" Style="{StaticResource HelperText}" Margin="0,0,0,10"/>

              <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <Grid Margin="0,0,0,5">
                    <TextBlock Text="Montant initial" Foreground="{StaticResource Muted}" FontSize="13"/>
                    <TextBlock Text="{Binding Selected.OriginalXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" FontSize="13" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid>
                    <TextBlock Text="Reste à payer" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding Selected.BalanceXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TerracottaDark}" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Le solde d'une réservation vaut remise de la marchandise : l'annoncer avant. -->
              <Border Background="{StaticResource SuccessSoft}" BorderBrush="{StaticResource Success}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10"
                      Visibility="{Binding SettlesAdvance, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Ce versement solde l'avance : la marchandise réservée doit être remise au client." TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Ink}"/>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:KeypadField Value="{Binding Amount}" Title="Montant reçu" Suffix="FCFA"/>
                <Button Grid.Column="1" Content="Tout solder" Command="{Binding PayInFullCommand}" MinWidth="110" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
              </Grid>

              <TextBlock Text="Moyen de paiement" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Moyen de paiement">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumFr}}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="Référence" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Reference}" controls:Placeholder.Text="Référence mobile money (optionnel)"/>

              <Button Content="Encaisser le versement" Command="{Binding PayCommand}" Style="{StaticResource HeroButton}" Margin="4,14,4,0"/>

              <TextBlock Text="Versements déjà reçus" Style="{StaticResource Eyebrow}" Margin="4,18,4,6"/>
              <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12"/>
                          <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding AmountXof, StringFormat={}{0:N0} FCFA}" Style="{StaticResource Money}" FontSize="13" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Grid.Column="2" Content="Annuler" Style="{StaticResource GridCellButton}" VerticalAlignment="Center"
                                Command="{Binding DataContext.ReverseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                ToolTip="Contre-passer ce versement (mode gérant requis)"
                                Visibility="{Binding DataContext.Session.IsManager, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="2,12,2,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
