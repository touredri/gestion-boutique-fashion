<UserControl x:Class="BoutiqueFashion.App.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8">
      <StackPanel Width="150"><TextBlock Text="Du" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FromDate}" ToolTip="AAAA-MM-JJ"/></StackPanel>
      <StackPanel Width="150"><TextBlock Text="Au" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ToDate}" ToolTip="AAAA-MM-JJ"/></StackPanel>
      <StackPanel Width="220"><TextBlock Text="Rapport" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding SelectedReportKind}"/></StackPanel>
      <Button Content="Actualiser" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
      <Button Content="Exporter CSV" Command="{Binding ExportCsvCommand}" VerticalAlignment="Bottom"/>
    </WrapPanel>
    <UniformGrid Grid.Row="1" Columns="5">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="VENTES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.SalesXof, StringFormat={}{0:N0} FCFA}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ENCAISSÉ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.CollectedXof, StringFormat={}{0:N0} FCFA}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MARGE BRUTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.GrossMarginXof, StringFormat={}{0:N0} FCFA}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BÉNÉFICE ESTIMÉ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.EstimatedProfitXof, StringFormat={}{0:N0} FCFA}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CRÉANCES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Summary.CreditBalanceXof, StringFormat={}{0:N0} FCFA}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="2" Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,8" Margin="6,4" Visibility="{Binding Summary.CostWarning, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Avertissement : certaines ventes de la période n'ont pas de coût d'achat renseigné. La marge et le bénéfice affichés sont donc incomplets." Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Rows}" Margin="0,6,8,0"><DataGrid.Columns><DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="MONTANT" Binding="{Binding ValueXof, StringFormat={}{0:N0} FCFA}" Width="160"/><DataGridTextColumn Header="QTÉ / ÉCART" Binding="{Binding Quantity}" Width="110"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="CLÔTURES DE CAISSE ET ÉCARTS" Style="{StaticResource Eyebrow}" Margin="4,6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Closings}" Margin="0,2,0,0"><DataGrid.Columns><DataGridTextColumn Header="CAISSE" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="ÉCART" Binding="{Binding DifferenceXof, StringFormat={}{0:N0}}"/><DataGridTextColumn Header="MOTIF" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource HelperText}" VerticalAlignment="Bottom" Margin="4,0,4,4"/>
  </Grid>
</UserControl>
