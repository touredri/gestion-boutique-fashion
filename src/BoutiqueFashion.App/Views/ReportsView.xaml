<UserControl x:Class="BoutiqueFashion.App.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    
    <!-- Barre de filtre et de sélection de période -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Boutons rapides de période -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Content="Aujourd'hui" Command="{Binding SetPeriodCommand}" CommandParameter="today" MinWidth="90" Margin="2,0"/>
          <Button Content="7 jours" Command="{Binding SetPeriodCommand}" CommandParameter="7" MinWidth="75" Margin="2,0"/>
          <Button Content="Ce mois" Command="{Binding SetPeriodCommand}" CommandParameter="month" MinWidth="80" Margin="2,0"/>
          <Button Content="30 jours" Command="{Binding SetPeriodCommand}" CommandParameter="30" MinWidth="75" Margin="2,0"/>
        </StackPanel>

        <!-- Date Du -->
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Text="Date début" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
          <TextBox Text="{Binding FromDate}" controls:Placeholder.Text="AAAA-MM-JJ" ToolTip="AAAA-MM-JJ"/>
        </StackPanel>

        <!-- Date Au -->
        <StackPanel Grid.Column="2" Margin="0,0,8,0">
          <TextBlock Text="Date fin" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
          <TextBox Text="{Binding ToDate}" controls:Placeholder.Text="AAAA-MM-JJ" ToolTip="AAAA-MM-JJ"/>
        </StackPanel>

        <!-- Type de rapport -->
        <StackPanel Grid.Column="3" Margin="0,0,10,0">
          <TextBlock Text="Type de rapport" Style="{StaticResource FieldLabel}" Margin="2,0,2,2"/>
          <ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding SelectedReportKind}"/>
        </StackPanel>

        <!-- Boutons d'action -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="Actualiser" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,6,0"/>
          <Button Content="Exporter CSV" Command="{Binding ExportCsvCommand}" MinWidth="110"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 5 Cartes KPI Principales -->
    <UniformGrid Grid.Row="1" Columns="5" Margin="-4,0,-4,10">
      <!-- Ventes -->
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="VENTES BRUTES" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Summary.SalesXof, StringFormat={}{0:N0} FCFA}" FontSize="18" FontWeight="Bold" Style="{StaticResource Money}" Foreground="{StaticResource Ink}"/>
        </StackPanel>
      </Border>
      <!-- Encaissé -->
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="ENCAISSÉ" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Summary.CollectedXof, StringFormat={}{0:N0} FCFA}" FontSize="18" FontWeight="Bold" Style="{StaticResource Money}" Foreground="{StaticResource Success}"/>
        </StackPanel>
      </Border>
      <!-- Marge Brute -->
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="MARGE BRUTE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Summary.GrossMarginXof, StringFormat={}{0:N0} FCFA}" FontSize="18" FontWeight="Bold" Style="{StaticResource Money}" Foreground="{StaticResource Gold}"/>
        </StackPanel>
      </Border>
      <!-- Bénéfice Estimé -->
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="BÉNÉFICE ESTIMÉ" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Summary.EstimatedProfitXof, StringFormat={}{0:N0} FCFA}" FontSize="18" FontWeight="Bold" Style="{StaticResource Money}" Foreground="{StaticResource Terracotta}"/>
        </StackPanel>
      </Border>
      <!-- Créances -->
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Text="CRÉANCES RESTANTES" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Summary.CreditBalanceXof, StringFormat={}{0:N0} FCFA}" FontSize="18" FontWeight="Bold" Style="{StaticResource Money}" Foreground="{StaticResource TerracottaDark}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Avertissement de coût -->
    <Border Grid.Row="2" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding Summary.CostWarning, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="⚠️ Avertissement : certaines ventes de la période sélectionnée n'ont pas de coût d'achat renseigné. La marge et le bénéfice affichés sont calculés partiellement." Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </Border>

    <!-- Tableaux de données -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      
      <!-- Rapport détaillé -->
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="DÉTAIL DU RAPPORT" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Label}" Width="*"/>
              <DataGridTextColumn Header="MONTANT" Binding="{Binding ValueXof, StringFormat={}{0:N0} FCFA}" Width="160"/>
              <DataGridTextColumn Header="QTÉ / ÉCART" Binding="{Binding Quantity}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Clôtures de caisse -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="CLÔTURES DE CAISSE ET ÉCARTS" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Closings}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SESSION CAISSE" Binding="{Binding Number}" Width="130"/>
              <DataGridTextColumn Header="ÉCART" Binding="{Binding DifferenceXof, StringFormat={}{0:N0} F}" Width="90"/>
              <DataGridTextColumn Header="MOTIF DE L'ÉCART" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
