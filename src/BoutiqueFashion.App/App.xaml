<Application x:Class="BoutiqueFashion.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:BoutiqueFashion.App.Converters">
  <Application.Resources>
    <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    <SolidColorBrush x:Key="Canvas" Color="#FFF4EFE8"/><SolidColorBrush x:Key="Ivory" Color="#FFFFFBF6"/><SolidColorBrush x:Key="Paper" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#FF211E1A"/><SolidColorBrush x:Key="Muted" Color="#FF6D665F"/><SolidColorBrush x:Key="MutedLight" Color="#FFA0988F"/>
    <SolidColorBrush x:Key="Terracotta" Color="#FFA84F35"/><SolidColorBrush x:Key="TerracottaDark" Color="#FF843923"/><SolidColorBrush x:Key="TerracottaSoft" Color="#FFF6E7E1"/>
    <SolidColorBrush x:Key="Gold" Color="#FFB88A42"/><SolidColorBrush x:Key="GoldSoft" Color="#FFF7EEDC"/><SolidColorBrush x:Key="Line" Color="#FFE3DBD1"/><SolidColorBrush x:Key="LineStrong" Color="#FFCFC4B7"/>
    <SolidColorBrush x:Key="Success" Color="#FF287158"/><SolidColorBrush x:Key="SuccessSoft" Color="#FFE5F3ED"/><SolidColorBrush x:Key="Danger" Color="#FFB43C3C"/><SolidColorBrush x:Key="DangerSoft" Color="#FFF9E7E7"/>
    <SolidColorBrush x:Key="Nav" Color="#FF211F1C"/><SolidColorBrush x:Key="NavHover" Color="#FF302D29"/><SolidColorBrush x:Key="NavActive" Color="#FF3A312B"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#FF352A23"/>

    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style TargetType="UserControl"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="4,5,4,1"/></Style>
    <Style x:Key="HelperText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Money" TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Terracotta}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Terracotta}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Terracotta}"/><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource TerracottaDark}"/><Setter Property="BorderBrush" Value="{StaticResource TerracottaDark}"/></Trigger></Style.Triggers></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerSoft}"/></Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>

    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/><Setter Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers></Style>
    <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Terracotta}"/></Trigger></Style.Triggers></Style>

    <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="48"/><Setter Property="ColumnHeaderHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="RowBackground" Value="{StaticResource Paper}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Ivory}"/><Setter Property="AlternationCount" Value="2"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Ivory}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource GoldSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource TerracottaSoft}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource Line}"/><Setter Property="Margin" Value="0,10"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/></Style>
    <Style x:Key="RaisedCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Effect" Value="{StaticResource CardShadow}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="{StaticResource SuccessSoft}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="11,6"/></Style>

    <Style x:Key="NavItem" TargetType="RadioButton"><Setter Property="Foreground" Value="#FFD9D2CA"/><Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="3"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/><Border x:Name="Marker" Grid.Column="2" Width="3" Height="22" CornerRadius="2" Background="Transparent"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource NavHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource NavActive}"/><Setter Property="Foreground" Value="White"/><Setter TargetName="Marker" Property="Background" Value="{StaticResource Gold}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
