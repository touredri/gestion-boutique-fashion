<Window x:Class="BoutiqueFashion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoutiqueFashion.App.ViewModels"
        xmlns:views="clr-namespace:BoutiqueFashion.App.Views"
        xmlns:controls="clr-namespace:BoutiqueFashion.App.Controls"
        Title="Boutique" Icon="/Assets/logo-nav.png" MinWidth="1024" MinHeight="600" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SaleViewModel}"><views:SaleView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StockViewModel}"><views:StockView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExpensesViewModel}"><views:ExpensesView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DocumentsViewModel}"><views:DocumentsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Nav}" Padding="18,16">
      <!-- LastChildFill=False : sinon la carte utilisateur, dernier enfant, s'étire sur tout
           l'espace restant au lieu de se fixer en bas, et son avatar se décale du texte. -->
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <Grid Margin="4,4,4,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10">
              <Image Source="/Assets/logo-nav.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Text="BOUTIQUE" Foreground="White" FontWeight="Bold" FontSize="14"/>
              <TextBlock Text="POINT DE VENTE" Foreground="{StaticResource Gold}" FontSize="10" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Espace de travail" Foreground="{StaticResource NavMuted}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,7"/>
          <RadioButton Content="Tableau de bord" Tag="&#xE80F;" GroupName="Navigation" AutomationProperties.Name="Tableau de bord" IsChecked="True" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
          <RadioButton Content="Vente / Caisse" Tag="&#xE719;" GroupName="Navigation" AutomationProperties.Name="Vente / Caisse" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Sale"/>
          <RadioButton Content="Produits" Tag="&#xE7BF;" GroupName="Navigation" AutomationProperties.Name="Produits" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Catalog"/>
          <RadioButton Content="Stock" Tag="&#xE8B7;" GroupName="Navigation" AutomationProperties.Name="Stock" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Stock" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
          <RadioButton Content="Clients" Tag="&#xE77B;" GroupName="Navigation" AutomationProperties.Name="Clients" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
          <RadioButton Content="Dépenses" Tag="&#xE8C7;" GroupName="Navigation" AutomationProperties.Name="Dépenses" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Expenses" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
          <RadioButton Content="Documents" Tag="&#xE8A5;" GroupName="Navigation" AutomationProperties.Name="Documents" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Documents" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
          <RadioButton Content="Rapports" Tag="&#xE9D2;" GroupName="Navigation" AutomationProperties.Name="Rapports" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
          <RadioButton Content="Paramètres" Tag="&#xE713;" GroupName="Navigation" AutomationProperties.Name="Paramètres" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Background="{StaticResource NavHover}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" VerticalAlignment="Center" Background="{StaticResource GoldSoft}" CornerRadius="15"><TextBlock Text="V" Foreground="{StaticResource TerracottaDark}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="Vendeur boutique" Foreground="White" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Session active" Foreground="{StaticResource NavMuted}" FontSize="11"/></StackPanel>
          </Grid>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Boutique Fashion" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
          </StackPanel>
          <!-- Indicateur de mode : sans lui, impossible de savoir si la caisse est déverrouillée. -->
          <Border Grid.Column="1" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center" Visibility="{Binding Session.IsManager, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="MODE GÉRANT" Foreground="{StaticResource Warning}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="· expire après 15 min d'inactivité" Foreground="{StaticResource Warning}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
    <controls:TouchKeypadOverlay Grid.ColumnSpan="2"/>
    <controls:TouchKeyboardOverlay Grid.ColumnSpan="2"/>
  </Grid>
</Window>
