<UserControl x:Class="BoutiqueFashion.App.Controls.KeypadField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10" MinHeight="48" Padding="12,0" Margin="4" Cursor="Hand" MouseLeftButtonUp="OnTap">
    <Grid>
      <TextBlock x:Name="DisplayText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
    </Grid>
  </Border>
</UserControl>
