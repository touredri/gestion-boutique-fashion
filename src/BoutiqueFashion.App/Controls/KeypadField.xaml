<UserControl x:Class="BoutiqueFashion.App.Controls.KeypadField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}">
  <Border x:Name="Surface" Background="{StaticResource Paper}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10" MinHeight="48" Padding="12,6" Margin="4" Cursor="Hand" MouseLeftButtonUp="OnTap">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Replié quand il n'y a pas de titre : la boîte garde alors exactement ses 48 px. -->
      <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabelInline}" Visibility="Collapsed"/>
      <TextBlock x:Name="DisplayText" Grid.Row="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
    </Grid>
  </Border>
</UserControl>
