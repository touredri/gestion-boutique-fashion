<UserControl x:Class="BoutiqueFashion.App.Controls.TouchKeypadOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
  <Grid Background="#80000000" MouseLeftButtonUp="OnCancel">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Paper}" CornerRadius="16" Padding="20" MinWidth="380" Effect="{StaticResource CardShadow}" MouseLeftButtonUp="OnCardTap">
      <StackPanel>
        <TextBlock x:Name="KeypadTitle" Style="{StaticResource SectionTitle}" Margin="2,0,0,8"/>
        <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,12">
          <TextBlock x:Name="KeypadDisplay" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource Money}" MinHeight="36"/>
        </Border>
        <UniformGrid Columns="3">
          <Button Content="1" Tag="1" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="2" Tag="2" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="3" Tag="3" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="4" Tag="4" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="5" Tag="5" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="6" Tag="6" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="7" Tag="7" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="8" Tag="8" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="9" Tag="9" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
        </UniformGrid>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Content="⌫" Style="{StaticResource KeypadButton}" AutomationProperties.Name="Effacer le dernier chiffre" Click="OnBackspace"/>
          <Button Grid.Column="1" Content="0" Tag="0" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Grid.Column="2" Content="✓" Style="{StaticResource KeypadButton}" Background="{StaticResource Terracotta}" Foreground="White" BorderBrush="{StaticResource Terracotta}" AutomationProperties.Name="Valider la saisie" Click="OnValidate"/>
        </Grid>
        <Button Content="Annuler" Style="{StaticResource QuietButton}" Margin="4,10,4,0" Click="OnCancelClick"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
