<UserControl x:Class="BoutiqueFashion.App.Controls.ShiftLockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
  <UserControl.Style>
    <Style TargetType="UserControl">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Style>

  <!-- Aucun geste d'annulation, contrairement au pavé tactile : un verrou qu'on referme d'un
       clic à côté ne verrouille rien. Le fond opaque intercepte tout ce qui passerait dessous. -->
  <Grid Background="{StaticResource Nav}">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Paper}" CornerRadius="18" Padding="28" MinWidth="400" Effect="{StaticResource CardShadow}">
      <StackPanel>
        <Border Background="{StaticResource TerracottaSoft}" CornerRadius="14" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
          <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource TerracottaDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="Caisse verrouillée" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding OperatorName, StringFormat=Vacation de {0}}" Style="{StaticResource HelperText}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="Saisissez le code de vacation ou le code gérant." Style="{StaticResource HelperText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14"/>

        <Border Background="{StaticResource Ivory}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
          <TextBlock x:Name="PinDisplay" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" MinHeight="34" Style="{StaticResource Money}"/>
        </Border>

        <UniformGrid Columns="3">
          <Button Content="1" Tag="1" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="2" Tag="2" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="3" Tag="3" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="4" Tag="4" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="5" Tag="5" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="6" Tag="6" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="7" Tag="7" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="8" Tag="8" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Content="9" Tag="9" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
        </UniformGrid>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Content="⌫" Style="{StaticResource KeypadButton}" AutomationProperties.Name="Effacer le dernier chiffre" Click="OnBackspace"/>
          <Button Grid.Column="1" Content="0" Tag="0" Style="{StaticResource KeypadButton}" Click="OnDigit"/>
          <Button Grid.Column="2" Content="✓" Style="{StaticResource KeypadButton}" Background="{StaticResource Terracotta}" Foreground="White" BorderBrush="{StaticResource Terracotta}" AutomationProperties.Name="Déverrouiller" Click="OnValidate"/>
        </Grid>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
