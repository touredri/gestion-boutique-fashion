    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BoutiqueFashion</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo-nav.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BoutiqueFashion.Application/BoutiqueFashion.Application.csproj" />
    <ProjectReference Include="../BoutiqueFashion.Infrastructure/BoutiqueFashion.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
</Project>
