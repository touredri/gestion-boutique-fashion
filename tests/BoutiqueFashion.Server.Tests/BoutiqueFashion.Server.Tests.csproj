<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Même fichier que côté terminal : une seule formulation de la règle. -->
    <Compile Include="../Shared/MigrationCompatibility.cs" Link="Shared/MigrationCompatibility.cs" />
    <ProjectReference Include="../../src/BoutiqueFashion.Server/BoutiqueFashion.Server.csproj" />
    <ProjectReference Include="../../src/BoutiqueFashion.Contracts/BoutiqueFashion.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Aligné explicitement : Mvc.Testing tire EF Core 10.0.0 par transitivité, alors que le
         serveur compile contre 10.0.11, et l'écart casse la liaison (CS1705). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
